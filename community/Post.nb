Cell["\<\
Figure 1. Across three trained networks (XOR, moons, spirals), the ReLU \
forward pass and the max-plus forward pass agree at ~10^-14 over 1400+ inputs \
each. Same function, two different algebras.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"3727cbcb-cb2b-41f4-9141-d5de3b10d066"],

Cell["One concrete forward pass, both ways", "Subsection",ExpressionUUID->"ba45dc22-d73d-4619-b412-c6b9d8adb5fa"],

Cell[TextData[{
 "It pays to follow a single input through both pipelines once, to feel why \
the equivalence is an algebraic identity rather than a numerical coincidence. \
We take the test point ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkX",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "cb08240c-e0fc-4d86-914d-3f32b6f452e7"],
 " and compute everything step by step on the trained moons net. First the \
classical ReLU pipeline:"
}], "Text",ExpressionUUID->"01658419-e100-4e58-b38f-abe580f391aa"],

Cell["\<\
xWalk    = {0.5, 0.3};
preact   = A . xWalk + b;        (* the 12 pre-activations  a_j . x + b_j *)
hidden   = Map[Max[0, #] &, preact];  (* ReLU activations  *)
outClass = c . hidden + d;       (* classical scalar output *)

{
  \"input x                  \" -> xWalk,
  \"pre-activations  A x + b \" -> N[preact, 4],
  \"hidden        ReLU(A x+b)\" -> N[hidden, 4],
  \"output         c . h + d \" -> N[outClass, 6],
  \"# units active (>0)      \" -> Count[preact, _?(# > 0 &)]
} // TableForm\
\>", "Input",ExpressionUUID->"3473b16e-8900-4c02-a780-26d959e02064"],

Cell[BoxData[
 PaneBox[
  TagBox[
   TagBox[GridBox[{
      {
       RowBox[{"\<\"input x                  \"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0.5`", ",", "0.3`"}], "}"}]}]},
      {
       RowBox[{"\<\"pre-activations  A x + b \"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "0.8057292580604554`", ",", "0.7472782171331346`", ",", 
          "1.1253128409385682`", ",", "1.5334078639745712`", ",", 
          RowBox[{"-", "0.6121905386447906`"}], ",", "0.3939442992210389`", ",", 
          RowBox[{"-", "0.8850599110126496`"}], ",", "0.4177246931940317`", ",", 
          RowBox[{"-", "0.8854766465723515`"}], ",", 
          RowBox[{"-", "1.7679912179708481`"}], ",", 
          RowBox[{"-", "0.12014119625091557`"}], ",", 
          RowBox[{"-", "0.8793979495763778`"}]}], "}"}]}]},
      {
       RowBox[{"\<\"hidden        ReLU(A x+b)\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "0.8057292580604554`", ",", "0.7472782171331346`", ",", 
          "1.1253128409385682`", ",", "1.5334078639745712`", ",", "0", ",", 
          "0.3939442992210389`", ",", "0", ",", "0.4177246931940317`", ",", 
          "0", ",", "0", ",", "0", ",", "0"}], "}"}]}]},
      {
       RowBox[{"\<\"output         c . h + d \"\>", "\[Rule]", 
        "0.9453237247202608`"}]},
      {
       RowBox[{"\<\"# units active (>0)      \"\>", "\[Rule]", "6"}]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$]]],
  Alignment->{Center, Top},
  ImageSize->Full,
  ScrollPosition->{0., 0.}]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"9006cdff-bb92-40b1-8e7c-8c20868cfa12"],

Cell[TextData[{
 "Reading the rows: the 12 pre-activations are a mix of positive and negative \
numbers; ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkActiveUnits",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "349969a4-0b0d-41fc-bec9-549fb160931a"],
 " of the 12 hidden units fire (their pre-activation is strictly positive), \
so ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"12", "-", "walkActiveUnits"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f0f8d564-a306-4c81-b026-087da0561c11"],
 " contribute zero to the output. Multiply the hidden vector by ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["c",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1fdf1cc0-bf87-4f70-937a-c14436ef9f69"],
 ", add ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["d",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "90305193-5a98-44fa-b082-2ae07d32a653"],
 ", and we get the scalar network output. Now the same input through the \
tropical pipeline, computing the two convex piecewise-linear surfaces ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e627d797-5999-4344-a36c-10c92387cfbb"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9b38d6c7-01f9-4cc4-9df5-89e06eb4ef7c"],
 " and subtracting:"
}], "Text",ExpressionUUID->"b8ab10fb-a6e5-401c-8fe1-250164c96810"],

Cell["\<\
P = Sum[If[c[[j]] > 0,
            Max[0, c[[j]] (A[[j]] . xWalk) + c[[j]] b[[j]]],
            0], {j, Length[c]}] + Max[d, 0];
Q = Sum[If[c[[j]] < 0,
            Max[0, -c[[j]] (A[[j]] . xWalk) - c[[j]] b[[j]]],
            0], {j, Length[c]}] + Max[-d, 0];

{
  \"P(x)             \" -> N[P, 6],
  \"Q(x)             \" -> N[Q, 6],
  \"P(x) - Q(x)      \" -> N[P - Q, 6],
  \"ReLU output      \" -> N[outClass, 6],
  \"| P - Q - outRL |\" -> N[Abs[(P - Q) - outClass], 4]
} // TableForm\
\>", "Input",ExpressionUUID->"f05759b4-dd2d-4148-9df7-ef856e0dcdce"],

Cell[BoxData[
 PaneBox[
  TagBox[
   TagBox[GridBox[{
      {
       RowBox[{"\<\"P(x)             \"\>", "\[Rule]", "2.244881436572277`"}]},
      {
       RowBox[{"\<\"Q(x)             \"\>", "\[Rule]", 
        "1.2995577118520163`"}]},
      {
       RowBox[{"\<\"P(x) - Q(x)      \"\>", "\[Rule]", 
        "0.9453237247202606`"}]},
      {
       RowBox[{"\<\"ReLU output      \"\>", "\[Rule]", 
        "0.9453237247202608`"}]},
      {
       RowBox[{"\<\"| P - Q - outRL |\"\>", "\[Rule]", 
        "2.220446049250313`*^-16"}]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$]]],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"909440d6-1e37-4076-91f2-84e7efb3234f"],

Cell[TextData[{
 "The two pipelines disagree by ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"N", "[", 
      RowBox[{"walkErrPt", ",", "4"}], "]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "cd77257c-cd02-490e-8292-425f64459f89"],
 " -- pure floating-point round-off. The convex max-plus surface ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ba397ed8-348a-4754-bd2d-e61f19a23b09"],
 " is the contribution of the ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkPosUnits",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "02a0aa45-99f6-4fb0-ace0-a2bc93f4da69"],
 " positive-weight units (plus the positive part of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["d",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "91f78add-fbb8-44c7-8833-aa3fc0486a21"],
 "), and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "30338487-d65c-4b96-9fdf-37244541eef4"],
 " is the contribution of the ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkNegUnits",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7da17473-1b72-47a8-9241-f964d8af8e3e"],
 " negative-weight units; their difference ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"P", "-", "Q"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "af6a5384-a44f-458a-9e62-4303aa798100"],
 " is the network function. This is the identity of \[Section]9 made concrete \
on real trained weights -- no approximation anywhere, just two different \
evaluation orders of the same scalar."
}], "Text",ExpressionUUID->"e323b7ef-7428-41bf-b24b-68ad065ec1b6"],

Cell["14.  Decision boundary as a tropical hypersurface", "Section",ExpressionUUID->"07c199c6-d650-497b-9efa-4a6cc49cb881"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8edd2143-2468-4e7e-b7e4-214d07dc9a1d"],
 " hidden units cut input space along ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bc13c42e-ab60-4492-9563-352a006ee0cd"],
 " straight crease lines ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["a", "j"], ".", "x"}], "+", 
       SubscriptBox["b", "j"]}], "\[LongEqual]", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ca7ef218-7f9e-4cc1-8eaf-872a7b597fe7"],
 ". On each open region of the resulting arrangement, the activation pattern ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"\[Sigma]", "\[Element]", 
      SuperscriptBox[
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], "n"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "db9641bb-32de-4060-a6bf-50cc02d0ac8f"],
 " is constant and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["f",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8283105e-3c84-4b2b-9983-4ca0a4e60b09"],
 " is affine. The decision boundary ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"f", "\[LongEqual]", "0"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3ba8e195-c465-456d-9c59-6a871f5247af"],
 " is the locus where the two convex piecewise-linear surfaces ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "23695224-7d08-41d1-adff-710f115b8ca0"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8baa8a27-4d31-4411-a3d0-98258841499a"],
 " meet -- a tropical hypersurface."
}], "Text",ExpressionUUID->"3d58bea3-7f32-410d-992e-03e79a2ce029"],

