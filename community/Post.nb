Cell[TextData[{
 "Reading off: from node 1 you can reach node 3 with weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["5",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9c6992ce-6bbf-4723-aa8f-84465986d43c"],
 " = ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"2", "+", "3"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "5a76cccc-6e61-4c66-8a38-d4fa2120fee7"],
 " via 1\[Rule]2\[Rule]3. The ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "69f7171c-cfc0-42ea-bc8d-166fe355490a"],
 " entries mean \"unreachable\" -- the additive identity, which absorbs ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CirclePlus",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "755d970f-3853-47f3-bca2-203db2d7565c"],
 "."
}], "Text",ExpressionUUID->"857dd83e-eb33-4032-b154-68e9475c8271"],

Cell["3.  Classical application -- shortest paths", "Section",ExpressionUUID->"3fb9fcc6-aff2-4b8b-8a0a-e336c908ca4a"],

Cell[TextData[{
 "Switch ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "749cd931-a89b-41fe-8b60-dc57bb9d7b4f"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Min",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "af486643-747b-4ebf-9345-4fcaa652bf0d"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"+", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "5d0383a5-e214-4af5-85b6-1812f8965d67"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "b4e8c275-3008-4cb7-9bec-ecab398a9d00"],
 " and the tropical Kleene star computes shortest-path distances. Concretely: \
the Bellman-Ford recurrence"
}], "Text",ExpressionUUID->"cfb94666-3dff-4d83-b365-41aa0b30f6ef"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["d", 
       RowBox[{"t", "+", "1"}]], "(", "v", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Min", "u"], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["d", "t"], "(", "u", ")"}], "+", 
       SubscriptBox["\"\<cost\>\"", 
        RowBox[{"u", ",", "v"}]]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"472bd216-d667-4ef6-bf17-0b618f6df2a5"],

Cell["\<\
is, in min-plus algebra, literally a tropical matrix-vector product. \
Iterating to a fixed point gives the Kleene star of the cost matrix, hence \
the entire all-pairs distance matrix.\
\>", "Text",ExpressionUUID->"7dcbdde5-3f0a-45b9-859f-3f05ed1c6be9"],

Cell[TextData[{
 "Our convenience wrapper ",
 StyleBox["MPShortestPathDistances",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 " negates the cost matrix, runs the max-plus KleeneStar, and negates back:"
}], "Text",ExpressionUUID->"42435542-7090-4a54-9bcf-34ed7e325c27"],

Cell["\<\
MPShortestPathDistances[adj_?MatrixQ] :=
  -KleeneStar[-adj /. -Infinity -> -Infinity];

(* A small 5-node weighted digraph. *)
edges = {1 -> 2 -> 3, 1 -> 3 -> 5, 2 -> 3 -> 1,
         2 -> 4 -> 4, 3 -> 5 -> 2, 4 -> 5 -> 1, 3 -> 4 -> 1};
n = 5;
costM = ConstantArray[Infinity, {n, n}];
Do[
  costM[[e[[1]], e[[2, 1]]]] = e[[2, 2]],
  {e, edges}];

distM = MPShortestPathDistances[costM];
distM // MatrixForm\
\>", "Input",ExpressionUUID->"99e5f71d-a627-4fa8-8cc3-07381d819a3e"],

