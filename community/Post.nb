Cell["\<\
Figure 8. An 8-task project DAG and its earliest schedule. The makespan = 7 \
is the longest path from any root to any leaf in the tropical sense.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"35ca2f6b-70c1-472e-8fb7-81bd9697424d"],

Cell["5.  Tropical polynomials and the Newton polytope", "Section",ExpressionUUID->"633f48a3-271e-4e7d-b357-c43e59a2b3ac"],

Cell[TextData[{
 "A ",
 StyleBox["tropical polynomial",
  FontWeight->"Bold"],
 " in d variables is a function of the form ",
 StyleBox["p(x) = max_i (a_i . x + c_i)",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 " where the a_i are integer (or real) exponent vectors and c_i are real \
coefficients. It is convex piecewise-linear by construction."
}], "Text",ExpressionUUID->"069d48b1-b512-4c40-a17b-bedcba79ba70"],

