Cell["\<\
A digraph with a dominant 4-cycle of total weight 10. Iterating x_{t+1} = A \
\[CircleDot] x_t grows mean(x) by exactly \[Lambda]_max = 2.5 per step.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"33337e6d-50e5-4e95-ac72-0a6a88a8f973"],

Cell["8.  ReLU = the tropical sum  0 \[CirclePlus] x", "Section",ExpressionUUID->"b2267bb1-b9e1-4756-a994-3d3d62478f7d"],

Cell[TextData[{
 "We have spent half the post inside the tropical semiring with no neural \
networks in sight. The bridge to neural networks is a single observation: ",
 StyleBox["ReLU is the unit operation of the max-plus semiring",
  FontWeight->"Bold"],
 "."
}], "Text",ExpressionUUID->"fe348169-4bd0-46c2-bf68-7f756af2b9c5"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"ReLU", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", "x"}], ")"}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", "x"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6d5e1fb8-5eca-47a5-b4ff-f358d1c7f8b5"],

Cell[TextData[{
 "It is the tropical sum of the input with the multiplicative identity ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["0",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f34aca6d-b3e8-4653-8a76-22e45e09a8e0"],
 ". A single ReLU unit on a pre-activation ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"a", " ", "x"}], "+", "b"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8cf08ad7-1749-499f-b23d-17e8b566d9a9"],
 " is therefore the smallest possible degree-1 tropical polynomial:"
}], "Text",ExpressionUUID->"a07658af-e172-4cfc-a14a-a55956e7d643"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"h", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "x"}], "+", "b"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"a", " ", "x"}], "+", "b"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"9b779986-9c76-4b86-814c-75373eacec29"],

Cell[TextData[{
 "Two affine \"monomials\" -- ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["0",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "61edd76f-c00d-48c2-90a4-f6f148139938"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"a", " ", "x"}], "+", "b"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "629b1b8b-6a8b-44c9-bec0-fc09dfa3d6d9"],
 " -- combined with one tropical sum. From here on, every operation a ReLU \
network performs has a direct counterpart in the max-plus algebra of \
\[Section]1--\[Section]7."
}], "Text",ExpressionUUID->"409e42cb-c7ed-4e49-9c2a-efb54fd65b11"],

