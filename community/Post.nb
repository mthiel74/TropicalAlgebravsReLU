    TagBox[
     RowBox[{"P", "\[LongEqual]", "e"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1c14bcc8-e0a6-46ab-857b-6a8b4a30fcd8"],
 " (a constant tropical polynomial) and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4d31c38f-7cea-4202-b942-2ef5e40c4b68"],
 " a tropical polynomial of degree 1. In both cases the decision boundary ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"f", "\[LongEqual]", "0"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "fd46eca6-9c06-4267-af90-1e1a168d2d91"],
 " is the locus ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"P", "\[LongEqual]", "Q"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9a8b6d7f-6cc5-4144-ab21-8c2b9af184e1"],
 " -- the tropical hypersurface."
}], "Text",ExpressionUUID->"2ec293a7-8a1e-447e-8e25-0237d52ee853"],

Cell[TextData[{
 "We check the derivation algebraically. The two expressions below must agree \
for every choice of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["a",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "39409b57-a9a1-41f6-875d-286dab88dcef"],
 ", ",
