Cell["\<\
An 8-task project DAG (left) and its earliest schedule (right). The makespan \
equals the longest path through the DAG, which is what the tropical Kleene \
star measures.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"c5224a61-b58c-4a7e-9f41-b2fff2cc446b"],

Cell["5.  Tropical polynomials in one variable", "Section",ExpressionUUID->"896f7631-a357-438f-ab39-66f65f01a931"],

Cell[TextData[{
 "A ",
 StyleBox["tropical polynomial",
  FontWeight->"Bold"],
 " in one variable is a max of finitely many affine functions:"
}], "Text",ExpressionUUID->"c7c7d8ab-cef9-4799-bb8a-38ec3bbeba6a"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"p", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Max", "i"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["a", "i"], " ", "x"}], "+", 
        SubscriptBox["c", "i"]}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"fd59f45d-904a-4759-9889-cb77b51b1d1f"],

Cell[TextData[{
 "with exponent ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["a", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4fbde0b0-8622-41d6-a7a9-507e2b032b4a"],
 " and coefficient ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["c", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "665333bc-7344-4f9b-b88b-761c0074f1be"],
 ". Geometrically it is convex piecewise-linear: a sequence of straight \
segments meeting at corners. The ",
 StyleBox["Newton polygon",
  FontWeight->"Bold"],
 " of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7ba05490-8f68-4d56-83d9-f21b4364f51f"],
 " is the upper convex hull of the lifted points ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["a", "i"], ",", 
       SubscriptBox["c", "i"]}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9c50ef0b-f32b-45b1-84fc-8ced7703072a"],
 " in the plane. Only monomials whose lifted point lies on the upper hull \
contribute a segment to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4adbc25f-e23c-41ee-a561-ad67ee2703e8"],
 "; interior monomials are dominated by other terms everywhere and contribute \
nothing."
}], "Text",ExpressionUUID->"37ee7276-ad6c-458f-8ac3-0fbe2b1468dc"],

Cell["\<\
poly = TropicalPolynomial[{{0}, {2}, {1}, {3}}, {2, 1, 2, -2}];
(* TropicalEval gives the value at a point *)
TropicalEval[poly, #] & /@ Transpose[{{-1, 0, 0.5, 1, 2}}]\
\>", "Input",ExpressionUUID->"f09a01a0-9ded-41bb-be83-cf7ce5aaf8ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2", ",", "2.5`", ",", "3", ",", "5"}], "}"}]], "Output",E\
xpressionUUID->"10e9b3d1-2f9b-4506-a517-6129e13f7cd4"],

Cell[TextData[{
 "The four monomials of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "168eda13-925d-458d-ba5b-b9ad0507f909"],
 " are ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["2",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ecce3be9-af8b-4409-a6cb-7a3918d5be66"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"2", " ", "x"}], "+", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "749ba1ee-ac44-4154-8087-25a8bd3f0510"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"x", "+", "2"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
