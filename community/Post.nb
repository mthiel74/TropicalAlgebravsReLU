Cell["\<\
A digraph with a dominant 4-cycle of total weight 10. Iterating x_{t+1} = A \
\[CircleDot] x_t grows mean(x) by exactly \[Lambda]_max = 2.5 per step.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"1239c392-d556-44f5-867d-337e0cc03f75"],

Cell["8.  ReLU = the tropical sum  0 \[CirclePlus] x", "Section",ExpressionUUID->"7d3b676e-ae7c-4480-aabf-81ea3eea2019"],

Cell[TextData[{
 "We have spent half the post inside the tropical semiring with no neural \
networks in sight. The bridge to neural networks is a single observation: ",
 StyleBox["ReLU is the unit operation of the max-plus semiring",
  FontWeight->"Bold"],
 "."
}], "Text",ExpressionUUID->"41afa81e-01ca-4e37-b8d3-aa57d23c39d0"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"ReLU", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", "x"}], ")"}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", "x"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"2ca0dc04-d346-4d64-9bb0-93eb65bb9d13"],

Cell[TextData[{
 "It is the tropical sum of the input with the multiplicative identity ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["0",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d3abeece-f28b-4f67-9364-b5a0966d1643"],
 ". A single ReLU unit on a pre-activation ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"a", " ", "x"}], "+", "b"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "80699c0c-9d14-4ec3-9afa-64f5045a8684"],
 " is therefore the smallest possible degree-1 tropical polynomial:"
}], "Text",ExpressionUUID->"b9e46c97-221d-454d-ac9f-ce523c34e9f6"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"h", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "x"}], "+", "b"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"a", " ", "x"}], "+", "b"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"74b67cb5-6433-4300-8d0b-cee83c6ead41"],

Cell[TextData[{
 "Two affine \"monomials\" -- ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["0",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a36367ca-73cd-46c0-901b-2a583c876e18"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"a", " ", "x"}], "+", "b"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "afff2179-2807-454c-8d68-08ad22650607"],
 " -- combined with one tropical sum. From here on, every operation a ReLU \
network performs has a direct counterpart in the max-plus algebra of \
\[Section]1--\[Section]7."
}], "Text",ExpressionUUID->"8d2538a1-2c95-432f-9e60-c91da1c85429"],

