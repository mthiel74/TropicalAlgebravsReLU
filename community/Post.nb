Cell["\<\
Illustration. Two interlocking crescents of coloured beads on sand -- our toy \
classification dataset. The class boundary is necessarily curved, so a linear \
classifier fails. Two-moons is the fruit fly of the small-MLP literature.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"c9c7266c-c6d0-4694-8f14-8f527045b662"],

Cell["Architecture and notation", "Subsection",ExpressionUUID->"e9a7f9fb-9f40-45c7-8cc1-aca11bc8f6d4"],

Cell[TextData[{
 "We pick a ",
 StyleBox["2 \[Rule] 12 \[Rule] 1",
  FontWeight->"Bold"],
 " ReLU multilayer perceptron -- two-dimensional input, twelve hidden ReLU \
units, scalar output. In symbols, with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"x", "\[Element]", 
      SuperscriptBox["R", "2"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "2e20db3f-cad5-48cf-a111-f63ddc802e6f"],
 ":"
}], "Text",ExpressionUUID->"52cd6645-1a56-418a-8143-b7a1107b3ad5"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"h", "\[LongEqual]", 
     RowBox[{"\"\<ReLU\>\"", "(", 
      RowBox[{
       RowBox[{"A", " ", "x"}], "+", "b"}], ")"}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"A", " ", "x"}], "+", "b"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"afb2b37e-5a73-4401-8668-9c8619035488"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"f", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"c", ".", "h"}], "+", "d"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"62b21b9e-0663-4128-b39d-1d1f6aeaff70"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d2e87bb6-6a4a-474e-bd0f-0887025d60d3"],
 " is a ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"12", " ", "2"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "154278b0-8f13-481f-98f7-db4add67bef1"],
 " weight matrix, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["b",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "43c1e21b-6f83-4de3-8e00-5f5b2f21a541"],
 " a length-12 hidden bias, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["c",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8a3ac6e1-4821-41ff-a852-e3da4fa02166"],
 " a length-12 output weight row, and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["d",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e0bb137f-e9c0-4a5a-9d05-b072af2696ab"],
 " a scalar output bias. There are ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"12", " ", "2"}], "+", "12", "+", "12", "+", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "639e8e6a-ff79-4380-8263-a44498e572b3"],
 " = ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["49",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e3016df9-233d-4d2b-9200-1e34b3ec6450"],
 " trainable parameters in total -- almost nothing. The decision rule is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"\"\<sign\>\"", "(", 
      RowBox[{"f", "(", "x", ")"}], ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ab80f932-9548-4baa-9306-c0bdc48e41f0"],
 ", so the trained classifier returns ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"+", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "eb5bbcd6-55b4-452a-b65e-c71d9ce347fd"],
 " on points where ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"f", ">", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8fb85055-c7c1-40ae-a946-c719da2d0918"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9f961dd6-b971-44ae-b4fc-0f5894afcea9"],
 " where ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"f", "<", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "23bcc6b9-056a-460d-a868-7e423b70c512"],
 ". The locus ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"f", "\[LongEqual]", "0"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1b51357b-8687-4892-af0a-3c6718995f6f"],
 " is the decision boundary, the protagonist of \[Section]14."
}], "Text",ExpressionUUID->"bfaa5299-7d6f-471f-a37f-c35997c90767"],

Cell["The training block", "Subsection",ExpressionUUID->"8924660b-9146-460e-867e-47c9d7591e83"],

Cell[TextData[{
 "The whole training run is six lines of high-level Wolfram Language. The \
block builds the dataset, wraps a ",
 StyleBox["NetChain",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 ", trains it for 800 epochs of mini-batch SGD, and extracts the trained \
weights into plain arrays ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"A", ",", "b", ",", "c", ",", "d"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "32e13f18-57a4-41d4-859f-f4f05667080f"],
 " for the tropical analysis to come. It runs in a fresh kernel in a few \
seconds; the resulting weights are already saved in ",
 StyleBox["data/moons_net.mx",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 " so the rest of the post can be reproduced without retraining."
}], "Text",ExpressionUUID->"b0da097c-e2a3-4e13-ab58-1bbd776b01ec"],

Cell["\<\
SeedRandom[7];
makeMoons[nPerClass_: 200, noise_: 0.15] :=
  Module[{th},
    th = Subdivide[0, Pi, nPerClass - 1];
    Join[
      Thread[{Transpose[{Cos[th], Sin[th]}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], 1}],
      Thread[{Transpose[{1 - Cos[th], -Sin[th] - 0.5}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], \
-1}]]
  ];

data      = makeMoons[];
trainData = (#[[1]] -> {N[#[[2]]]}) & /@ data;

trained = NetTrain[
  NetChain[{LinearLayer[12], ElementwiseLayer[\"ReLU\"], LinearLayer[1]},
           \"Input\" -> 2],
  trainData,
  MaxTrainingRounds -> 800,  BatchSize -> 64,
  LearningRate -> 0.01,      TrainingProgressReporting -> None,
  RandomSeeding -> 1];

A = Normal @ NetExtract[trained, {1, \"Weights\"}];
b = Normal @ NetExtract[trained, {1, \"Biases\"}];
c = Flatten @ Normal @ NetExtract[trained, {3, \"Weights\"}];
d = First @ Flatten @ Normal @ NetExtract[trained, {3, \"Biases\"}];\
\>", "Input",ExpressionUUID->"fdc33fb9-26ab-4031-b191-44a6790205c2"],

Cell[TextData[{
 "What did the training actually do? It nudged the 49 numbers in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"A", ",", "b", ",", "c", ",", "d"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9c8d8375-e5ef-4dd9-a2e4-e5f5acde0989"],
 " around until the network outputs roughly ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"+", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4b6e8ee0-9004-4102-aaa3-71548f127cca"],
 " on the upper crescent and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c1be8e8a-ea1c-4b08-8c19-b8f54dc7cdb2"],
 " on the lower one. Different runs land on different weights -- there are \
many networks that solve the same task -- but the ",
 StyleBox["function",
  FontSlant->"Italic"],
 " each one computes is what we now analyse. Of the trained ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkNHidden",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "66375220-a811-4a90-a652-9a9acfaa646d"],
 " hidden units, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkPosUnits",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "b352f8a8-46a6-40a5-95c0-4572fb9b28d5"],
 " end up with positive output weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["c", "j"], ">", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3295ef49-f7ac-4c14-8b21-eeff711623bd"],
 " (they feed into the ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e26fc232-cc80-47b3-8eda-892543debeaf"],
 " polynomial of \[Section]9), and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["walkNegUnits",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e3bb560f-bfcf-4b40-9387-ccf82e3344b2"],
 " end up negative (they feed into ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "22e4cd89-3abb-4455-ba95-820e8577e111"],
 ")."
}], "Text",ExpressionUUID->"bac20871-c4b2-42f1-bcb2-66806513de26"],

Cell["\<\
Now write the two forward passes explicitly and compare them:\
\>", "Text",ExpressionUUID->"34d2b94b-d55d-443c-be76-0ea96ed31e7d"],

Cell["\<\
fReLU[x_]    := c . Map[Max[0, #] &, A . x + b] + d;

fMaxPlus[x_] := Module[{P, Q},
  P = Sum[If[c[[j]] > 0,
              Max[0, c[[j]] (A[[j]] . x) + c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[d, 0];
  Q = Sum[If[c[[j]] < 0,
              Max[0, -c[[j]] (A[[j]] . x) - c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[-d, 0];
  P - Q
];

SeedRandom[123];
xs = RandomReal[{-2, 2}, {2000, 2}];
Max[Abs[fReLU /@ xs - fMaxPlus /@ xs]]\
\>", "Input",ExpressionUUID->"8c287029-5934-4f6b-9935-e2d883a0e5b7"],

Cell[BoxData[
 PaneBox["2.3314683517128287`*^-15",
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"18c02866-52c5-4621-a7e9-00c3c60c048d"],

Cell[TextData[{
 "The two evaluators agree to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["fwErr",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "95028ff8-2975-4f22-b3ce-b2a31345aa55"],
 " over 2000 random points. They compute the same function -- in two \
different algebras."
}], "Text",ExpressionUUID->"00331b74-9604-4919-8cb6-49c353c35fca"],

