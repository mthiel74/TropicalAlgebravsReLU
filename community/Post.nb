Cell["\<\
An 8-task project DAG (left) and its earliest schedule (right). The makespan \
equals the longest path through the DAG, which is what the tropical Kleene \
star measures.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"e3091989-310a-46c7-bb3c-142982bfde96"],

Cell["5.  Tropical polynomials in one variable", "Section",ExpressionUUID->"d1c1a128-873d-4dee-8edc-b38aca203d2f"],

Cell[TextData[{
 "A ",
 StyleBox["tropical polynomial",
  FontWeight->"Bold"],
 " in one variable is a max of finitely many affine functions:"
}], "Text",ExpressionUUID->"4848b6a8-ca08-47f6-ba21-b05c63afe8c1"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"p", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Max", "i"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["a", "i"], " ", "x"}], "+", 
        SubscriptBox["c", "i"]}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"d526ba62-ea6e-4d71-85f1-17975e45ceb4"],

Cell[TextData[{
 "with exponent ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["a", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a36f8dbd-4227-45d5-901f-35f4bf89b219"],
 " and coefficient ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["c", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f928615e-27fc-47bc-9ed8-ecf6cc21b0ce"],
 ". Geometrically it is convex piecewise-linear: a sequence of straight \
segments meeting at corners. The ",
 StyleBox["Newton polygon",
  FontWeight->"Bold"],
 " of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ceaa669c-1526-4b5b-96ac-f694938bb354"],
 " is the upper convex hull of the lifted points ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["a", "i"], ",", 
       SubscriptBox["c", "i"]}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bb9186ed-d5ae-43d5-92c4-4d7cb81cb3b5"],
 " in the plane. Only monomials whose lifted point lies on the upper hull \
contribute a segment to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f515212e-2673-4380-94d1-9037f6879a98"],
 "; interior monomials are dominated by other terms everywhere and contribute \
nothing."
}], "Text",ExpressionUUID->"a363da4e-ecca-4865-9e17-b9340b8294f8"],

Cell["\<\
poly = TropicalPolynomial[{{0}, {2}, {1}, {3}}, {2, 1, 2, -2}];
(* TropicalEval gives the value at a point *)
TropicalEval[poly, #] & /@ Transpose[{{-1, 0, 0.5, 1, 2}}]\
\>", "Input",ExpressionUUID->"1db636d4-b3b7-413f-9e04-d23410d2c1d8"],

Cell[BoxData[
 PaneBox[
  RowBox[{"{", 
   RowBox[{"2", ",", "2", ",", "2.5`", ",", "3", ",", "5"}], "}"}],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"f230b5e9-8da9-47f6-b11a-c9dc49608c15"],

Cell[TextData[{
 "The four monomials of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["p",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "17169610-f036-4dec-8e1b-0bd35b570dfd"],
 " are ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["2",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "77f61417-3b52-46e0-8bf3-14006201b2ed"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"2", " ", "x"}], "+", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "94b785ea-5854-4f52-a913-ed6706cd7ae0"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"x", "+", "2"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "07aed934-eeed-4e21-8bd5-40e11342d533"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"3", " ", "x"}], "-", "2"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3d565fe8-94da-4b60-ba4f-bba4f47c08a9"],
 ". For ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"x", "\[LongEqual]", 
      RowBox[{"-", "1"}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3839884e-c028-43da-b678-5e69c4cc4bdc"],
 " the values are ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     TemplateBox[{
       RowBox[{
        "2", "+", "\",\"", "-", "1", "+", "\",\"", "+", "1", "+", "\",\"", 
         "-", "5"}]},
      "RowDefault"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4958712d-7fc9-4885-82e0-9e4d18616bfb"],
 " whose max is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
     "poly1Vals", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f307860e-263a-472c-aefb-fe04abb6e962"],
 ", and so on."
}], "Text",ExpressionUUID->"502dd024-63e1-4204-8cd4-50b8e777692a"],

