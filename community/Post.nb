 StyleBox["Maxout Networks",
  FontSlant->"Italic"],
 ". ICML 2013. arXiv:1302.4389.\n\n",
 "R. M. Karp. ",
 StyleBox["A characterization of the minimum cycle mean in a digraph",
  FontSlant->"Italic"],
 ". Discrete Math. 23 (1978), 309-311.\n\n",
 "Wolfram Community discussion on max-plus algebra: \
community.wolfram.com/groups/-/m/t/162609\n\n",
 "Companion repository: ",
 StyleBox["github.com/mthiel74/TropicalAlgebravsReLU",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 "."
}], "Text",ExpressionUUID->"fbedec71-85aa-456e-9985-f71859abc092"]
