     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "436d70bc-73ff-448a-bb0a-1f28a5f1472c"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["w", "2"], " ", 
      SubscriptBox["a", "2"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f43fdcd6-c2db-4096-8646-05a2e898ed5d"],
 " in slope space (the intercepts ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["w", "j"], " ", 
      SubscriptBox["b", "j"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9d76ec11-ba40-4dc4-bf8a-4e606094b084"],
 " live separately as the lifting heights, not as a third side)."
}], "Text",ExpressionUUID->"7a5f6cf4-d2a6-40ea-9d54-ff1853c22eef"],

