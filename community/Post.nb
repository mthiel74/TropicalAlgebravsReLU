Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"Q", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        TemplateBox[{
          SubscriptBox["w", "2"]},
