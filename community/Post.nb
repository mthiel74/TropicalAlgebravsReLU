Cell["\<\
Figure 2. Decision boundary = tropical hypersurface for three trained \
classifiers (XOR, moons, spirals). Pastel patches are activation-pattern \
regions; thin grey lines are the ReLU creases; the black curve is the ReLU {f \
= 0}; the red dashed curve is the max-plus {P = Q} -- they coincide.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"2195838c-acf3-4eec-9b39-bf554b234d0e"],

Cell["15.  Newton polytope of the trained network", "Section",ExpressionUUID->"1abc6d50-bbe7-46fa-9a80-9831cac7ffe9"],

Cell[TextData[{
 "Each ReLU unit ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e460cfcd-5577-4094-a633-7dad7016de6a"],
 " with output weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["c", "j"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "6c9af76f-f173-4b0d-9966-854bb86b5794"],
 " contributes a tropical monomial of slope ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["c", "j"], " ", 
      SubscriptBox["a", "j"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "60f78e92-b6a3-434e-a0b3-b92356aed3c1"],
 " and intercept ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["c", "j"], " ", 
      SubscriptBox["b", "j"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "65ad1850-89ea-46af-94fe-948fb0ff04aa"],
 ", in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d3c764cd-03d4-4d47-bf31-8e700da96bda"],
 " if its output weight is positive and in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ff3b5512-8a6b-429f-a8fb-0cbc1e210549"],
 " if negative (the constant terms are the positive and negative parts of the \
output bias ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["d",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1fbaf3cc-b5e6-4244-91c1-464eaa170dfe"],
 ")."
}], "Text",ExpressionUUID->"fd84179d-b784-44f8-a846-f6bf32e9280f"],

Cell["\<\
dec = TropicalDecomposition[<|\"A\" -> A, \"b\" -> b, \"c\" -> c,
                              \"d\" -> d|>];
{Length[dec[\"Pmon\"]] + 1, Length[dec[\"Qmon\"]] + 1}\
\>", "Input",ExpressionUUID->"bf07ee3f-270a-4d6d-b36c-797f0b247701"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "7"}], "}"}]], "Output",ExpressionUUID->"e151b461-dca1-48ea-8159-06f43788ec25"],

Cell[TextData[{
 "Counting the implicit constant monomial, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "54d69baa-b570-4478-9985-e4af80bade05"],
 " has ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["pmons",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "edccabd1-5474-4c72-947e-d3278338cb4b"],
 " monomials and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4d6fd554-4872-4dc8-8aa6-d4fa4b9fcb4f"],
 " has ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["qmons",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ae26bc89-cf62-403c-83b0-cfe30f0a7514"],
 " -- the trained network's positive and negative \"halves\" each have a \
Newton polygon of this many candidate vertices in slope-intercept space. Only \
the ones on the upper hull realise a region in input space:"
}], "Text",ExpressionUUID->"fee3fac9-d0ee-4b45-bfd1-2e593c0d1412"],

