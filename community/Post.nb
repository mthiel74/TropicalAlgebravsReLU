Cell["\<\
Figure 2. Decision boundary = tropical hypersurface for three trained \
classifiers (XOR, moons, spirals). Pastel patches are activation-pattern \
regions; thin grey lines are the ReLU creases; the black curve is the ReLU {f \
= 0}; the red dashed curve is the max-plus {P = Q} -- they coincide.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"640a81d5-60f0-430e-9a63-67867f072119"],

Cell["15.  Newton polytope of the trained network", "Section",ExpressionUUID->"64acaf5a-8cde-4aac-b5a0-4aaae316989a"],

Cell[TextData[{
 "Each ReLU unit ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c9305973-4118-4488-9ad8-9fdead915ec8"],
 " with output weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["c", "j"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f1ae20c0-80f8-4c8c-9fce-257fa0d70e94"],
 " contributes a tropical monomial of slope ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["c", "j"], " ", 
      SubscriptBox["a", "j"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "79e56e48-c7df-415d-9cb5-682648df6907"],
 " and intercept ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["c", "j"], " ", 
      SubscriptBox["b", "j"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "2484af8d-c36a-4f37-9938-465a526fe2c4"],
 ", in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "76f0af3d-f4e2-4bc8-8e39-b407d1c7b1e1"],
 " if its output weight is positive and in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9d1d0940-716b-409e-959b-05fe5c88c372"],
 " if negative (the constant terms are the positive and negative parts of the \
output bias ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["d",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "b131d409-5249-43d4-81c9-b5ae7d0d821b"],
 ")."
}], "Text",ExpressionUUID->"7a20c0f1-c6b7-487b-b527-eb5d6d1bc3ed"],

Cell["\<\
dec = TropicalDecomposition[<|\"A\" -> A, \"b\" -> b, \"c\" -> c,
                              \"d\" -> d|>];
{Length[dec[\"Pmon\"]] + 1, Length[dec[\"Qmon\"]] + 1}\
\>", "Input",ExpressionUUID->"f5723c4a-bd8f-41dd-b711-78dfc5132c3b"],

Cell[BoxData[
 PaneBox[
  RowBox[{"{", 
   RowBox[{"7", ",", "7"}], "}"}],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"16f025dc-3e5b-4b72-b4be-dd44f0572105"],

Cell[TextData[{
 "Counting the implicit constant monomial, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "6e499694-672a-4198-9d7b-f732d3df60a9"],
 " has ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["pmons",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "490064db-e29e-49ea-bf4f-04c620e177d9"],
 " monomials and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d1fa830f-e14d-4e9f-b16b-0643108e8315"],
 " has ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["qmons",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "306c1ff6-3f15-4999-bee7-c238311fbf56"],
 " -- the trained network's positive and negative \"halves\" each have a \
Newton polygon of this many candidate vertices in slope-intercept space. Only \
the ones on the upper hull realise a region in input space:"
}], "Text",ExpressionUUID->"2138db2d-48fe-4531-84da-55844aa481f7"],

