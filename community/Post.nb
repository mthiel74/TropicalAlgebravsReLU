Cell["\<\
Figure 12. The 2 -> 2 -> 1 network has, when both output weights are \
positive, a single tropical polynomial of degree 1 with 4 monomials (the \
Minkowski sum of two segments).  With mixed signs it is a genuine difference \
P - Q.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"37228cbc-de49-4a0a-9b13-e47396c09bef"],

Cell["11.  Train a tiny classifier", "Section",ExpressionUUID->"78b20441-fce4-4851-bc8d-9def534f75b8"],

Cell["\<\
We pick the two-moons dataset and a 2 -> 12 -> 1 ReLU MLP. The code below is \
what you'd type in a fresh kernel.\
\>", "Text",ExpressionUUID->"8d9757ca-540d-4823-ae55-ab8ac7220460"],

Cell["\<\
SeedRandom[7];
makeMoons[nPerClass_: 200, noise_: 0.15] :=
  Module[{th},
    th = Subdivide[0, Pi, nPerClass - 1];
    Join[
      Thread[{Transpose[{Cos[th], Sin[th]}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], 1}],
      Thread[{Transpose[{1 - Cos[th], -Sin[th] - 0.5}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], \
-1}]]
  ];
data = makeMoons[];
trainData = (#[[1]] -> {N[#[[2]]]}) & /@ data;

netSpec = NetChain[
  {LinearLayer[12], ElementwiseLayer[\"ReLU\"], LinearLayer[1]},
  \"Input\" -> 2];

trained = NetTrain[netSpec, trainData,
  MaxTrainingRounds -> 800, BatchSize -> 64, LearningRate -> 0.01,
  TrainingProgressReporting -> None, RandomSeeding -> 1];\
\>", "Input",ExpressionUUID->"813db06d-cb2b-4ddd-b182-2ec493a55593"],

Cell["\<\
(* extract the trained weights *)
A = Normal @ NetExtract[trained, {1, \"Weights\"}];
b = Normal @ NetExtract[trained, {1, \"Biases\"}];
c = Flatten @ Normal @ NetExtract[trained, {3, \"Weights\"}];
d = First @ Flatten @ Normal @ NetExtract[trained, {3, \"Biases\"}];

(* two forward passes *)

fReLU[x_]    := c . Map[Max[0, #] &, A . x + b] + d;

fMaxPlus[x_] := Module[{P, Q},
  P = Sum[If[c[[j]] > 0,
              Max[0, c[[j]] (A[[j]] . x) + c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[d, 0];
  Q = Sum[If[c[[j]] < 0,
              Max[0, -c[[j]] (A[[j]] . x) - c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[-d, 0];
  P - Q
];

SeedRandom[123];
xs   = RandomReal[{-2, 2}, {2000, 2}];
yR   = fReLU /@ xs;
yMP  = fMaxPlus /@ xs;
Max[Abs[yR - yMP]]\
\>", "Input",ExpressionUUID->"b16a5ccd-cc65-4466-b095-d9cbca522044"],

Cell["\<\
The two evaluators agree to machine precision -- they are the same function \
in two different algebras.\
\>", "Text",ExpressionUUID->"e2c0fd1b-0f34-400b-889a-71977ffa6af1"],

Cell["12.  Forward-pass equivalence on the three datasets", "Section",ExpressionUUID->"a4b918aa-48d7-4b6a-9834-6ecf73b80193"],

