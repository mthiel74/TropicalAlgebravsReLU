Cell["\<\
Two arithmetic operations as physical actions. Left: three pillars of \
different heights; the tropical sum a \[CirclePlus] b \[CirclePlus] c picks \
the tallest. Right: the same three pillars laid end-to-end; the tropical \
product a \[CircleTimes] b \[CircleTimes] c stacks their lengths. No carries, \
no negative numbers -- max-plus arithmetic is what you would do if all you \
had was a ruler and the ability to compare lengths.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"a6d0e847-acb9-4a6f-88f3-40b1504bc6e9"],

Cell["Operators in WL", "Subsection",ExpressionUUID->"8bc398b4-d03f-4b37-917f-cb4364d1d662"],

Cell[TextData[{
 "We attach the definitions of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CirclePlus",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1223aef1-bada-4001-81ce-c74c1a407ec3"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CircleTimes",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9f705db2-c328-4d8c-8ff5-3bcfb360423c"],
 ", and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CircleDot",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a0b94939-ec57-4587-bc9f-e7be20b8d23a"],
 " to the System` symbols once, so the standard infix syntax just works. The \
Listable, Flat, OneIdentity, Orderless attributes give us elementwise \
behaviour, n-ary forms, and the simplifications a commutative associative \
operator should have."
}], "Text",ExpressionUUID->"0f39217e-1d72-471a-8d48-9e4f5a700322"],

Cell["\<\
Unprotect[System`CirclePlus, System`CircleTimes, System`CircleDot];

System`CirclePlus[a_, b_]   := Max[a, b];
System`CirclePlus[a_, b__]  := Max[a, b];
SetAttributes[System`CirclePlus, {Listable, Flat, OneIdentity, Orderless}];

System`CircleTimes[a_, b_]  := a + b;
System`CircleTimes[a_, b__] := Plus[a, b];
SetAttributes[System`CircleTimes, {Listable, Flat, OneIdentity, Orderless}];

System`CircleDot[A_?MatrixQ, B_?MatrixQ] := Inner[Plus, A, B, Max];
System`CircleDot[A_?MatrixQ, v_?VectorQ] := Inner[Plus, A, v, Max];
System`CircleDot[v_?VectorQ, A_?MatrixQ] := Inner[Plus, v, A, Max];

Protect[System`CirclePlus, System`CircleTimes, System`CircleDot];

{3 \\[CirclePlus] 7,  3 \\[CircleTimes] 7,
 {1, 2, 3} \\[CirclePlus] {4, 0, 5},
 {1, 2, 3} \\[CircleTimes] 10}\
\>", "Input",ExpressionUUID->"0ce481c3-6f26-4a98-8037-8de397d9637f"],

Cell[BoxData[
 PaneBox[
  RowBox[{"{", 
   RowBox[{"7", ",", "10", ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "2", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"11", ",", "12", ",", "13"}], "}"}]}], "}"}],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"b8c30c10-3a2d-45a6-a5cc-b8b97fba9734"],

Cell[TextData[{
 "The list arithmetic comes for free because of the Listable attribute. The \
first two scalar results say that, in max-plus, ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"3", "\[CirclePlus]", "7"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "aaf042da-17e9-446c-b1db-40711ba15650"],
 " is 7 (the larger of the two) and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"3", "\[CircleTimes]", "7"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "07eada5c-bad3-41c0-b1c2-361e8cbc38bf"],
 " is 10 (their classical sum). The vector ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], "\[CirclePlus]", 
      RowBox[{"{", 
       RowBox[{"4", ",", "0", ",", "5"}], "}"}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "0e9bbad3-65b4-49fd-ac26-6cddf50cb8f9"],
 " is the elementwise max ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"4", ",", "2", ",", "5"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "72361890-792d-417e-a1fa-cd957fa5af58"],
 ". The last expression scales every entry by 10 in the tropical sense, which \
is classical addition of 10 to each."
}], "Text",ExpressionUUID->"6ac88b80-60dd-49b8-a5c2-5a44db03fa27"],

Cell["2.  Tropical vectors and matrices", "Section",ExpressionUUID->"8b9c014b-bd8c-4300-a141-6bbd53120102"],

Cell["\<\
A tropical vector or matrix is just a real array; what changes is the \
multiplication. The tropical matrix product replaces the usual \"sum of \
products\" with \"max of sums\":\
\>", "Text",ExpressionUUID->"2a86feed-0cd2-413b-883e-300357e44e3c"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox[
      RowBox[{"A", "\[CircleDot]", "B"}], 
      RowBox[{"i", ",", "j"}]], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Max", "k"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["A", 
         RowBox[{"i", ",", "k"}]], "+", 
        SubscriptBox["B", 
         RowBox[{"k", ",", "j"}]]}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"a32bc274-380b-4e71-987e-0d5904efee43"],

Cell[TextData[{
 "implemented as ",
 StyleBox["Inner[Plus, A, B, Max]",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 " in WL. The identity matrix has 0 on the diagonal and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "54cbb91f-d1bd-42ae-b54c-5123f6b16fa0"],
 " elsewhere (since ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7f7f4945-009b-40de-b93a-fd1f2c401e1b"],
 " is the new \"zero\")."
}], "Text",ExpressionUUID->"186e3fe3-6917-4c3e-8ce6-0a3ad9c1e4d0"],

Cell["\<\
MPIdentity[n_Integer] :=
  Normal @ SparseArray[{i_, i_} -> 0, {n, n}, -Infinity];

MPMatrixPower[A_, 0]  := MPIdentity[Length[A]];
MPMatrixPower[A_, 1]  := A;
MPMatrixPower[A_, k_] := Nest[A \\[CircleDot] # &, A, k - 1];

A = {{1, 2}, {3, 0}};
B = {{0, -1}, {2, 4}};
{
  \"A . B (classical)\"     -> A . B,
  \"A \\[CircleDot] B\"     -> A \\[CircleDot] B,
  \"A^2 (classical)\"       -> MatrixPower[A, 2],
  \"A^2 (tropical)\"        -> MPMatrixPower[A, 2],
  \"MPIdentity[2] \\[CircleDot] A\" ->
                                MPIdentity[2] \\[CircleDot] A
} // TableForm\
\>", "Input",ExpressionUUID->"5a6e0534-5ce8-4660-b3fd-855636e2dbcb"],

Cell[BoxData[
 PaneBox[
  TagBox[
   TagBox[GridBox[{
      {
       RowBox[{"\<\"A . B (classical)\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"4", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "3"}]}], "}"}]}], "}"}]}]},
      {
       RowBox[{"\<\"A \[CircleDot] B\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"4", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}]},
      {
       RowBox[{"\<\"A^2 (classical)\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"7", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "6"}], "}"}]}], "}"}]}]},
      {
       RowBox[{"\<\"A^2 (tropical)\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"5", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}]},
      {
       RowBox[{"\<\"MPIdentity[2] \[CircleDot] A\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "0"}], "}"}]}], "}"}]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$]]],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"30d49343-860a-48fd-999d-ad49ef7eb8ce"],

Cell[TextData[{
 "Compare the first two rows: classical ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"A", ".", "B"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "6f6d3763-83e2-4daa-abcf-47c022d5e58d"],
 " is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"4", "7"},
        {"0", 
         RowBox[{"-", "3"}]}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.7]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}], "\[NoBreak]", ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d36351fd-f787-416a-b58f-e51231b4cc1b"],
 " whereas tropical ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"A", "\[CircleDot]", "B"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9ecfa327-ef48-451c-a27b-80ceede5614b"],
 " is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"4", "6"},
        {"3", "4"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.7]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}], "\[NoBreak]", ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ccfed769-15b4-44bf-b5d3-fc470acfff5b"],
 ". Entry ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\"\<(A\[CircleDot]B)\>\"", "\"\<1,1\>\""],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "2a682256-cce6-4b19-8d24-3b159130f308"],
 " of the tropical product is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"max", "(", 
      RowBox[{
       RowBox[{"1", "+", "0"}], ",", 
       RowBox[{"2", "+", "2"}]}], ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "683b3e6d-070b-4cfb-81b4-0b56461814bf"],
 " = ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["4",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "02aeacf9-17f1-4411-9df5-4c7e39bddd6d"],
 ", and so on. The identity matrix really is an identity: ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["\[ImaginaryI]", "2"], "\[CircleDot]", "A"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d2810e68-1821-40ac-b103-9dbe59b92ba2"],
 " = ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9ce1e6dc-d7ec-4e2e-918d-3316690e9dba"],
 "."
}], "Text",ExpressionUUID->"6cbf01e2-a7e5-4d96-bbe2-d47339ba5d4c"],

Cell["What is the tropical matrix product computing?", "Subsection",ExpressionUUID->"81034727-6b8a-428a-a7f0-1cedd8c65da2"],

Cell[TextData[{
 "The formula ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["\"\<(A \[CircleDot] B)\>\"", 
       RowBox[{"i", ",", "j"}]], "\[LongEqual]", 
      RowBox[{
       UnderscriptBox["Max", "k"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["A", 
          RowBox[{"i", ",", "k"}]], "+", 
         SubscriptBox["B", 
          RowBox[{"k", ",", "j"}]]}], ")"}]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4315906b-c385-42e5-a3f4-d13789578880"],
 " has an immediate graph reading. Think of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "93ff94ee-0393-4b3c-ac6c-8b44df176acf"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["B",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a5301922-ec6d-4e7a-ad75-ede280309f1a"],
 " as ",
 StyleBox["weighted adjacency matrices",
  FontWeight->"Bold"],
 " of two directed graphs on the same vertex set, with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["A", 
      RowBox[{"i", ",", "k"}]],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7b9706c8-a8fc-469a-be51-f234e90a0d14"],
 " the weight of the edge ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"i", "\[Rule]", "k"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "24fa8304-6316-412d-b2a5-1b64e0ed53a0"],
 " in graph A (or ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "2d55d7d0-d9ec-4e15-96b3-fff7233f6c4d"],
 " if no such edge exists), and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["B", 
      RowBox[{"k", ",", "j"}]],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c67187f2-630e-4df2-9c3c-b3f3d6631cfe"],
 " similarly. Then ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\"\<(A \[CircleDot] B)\>\"", 
      RowBox[{"i", ",", "j"}]],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c324baea-534e-4948-adcd-772c84a5f2f1"],
 " is the weight of the ",
 StyleBox["heaviest two-step walk",
  FontWeight->"Bold"],
 " from ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["i",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a02c01d6-56d9-4493-9ccb-be9ac67a3ab5"],
 " to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "62deb3a9-26ae-4bca-8db7-28b092c0a866"],
 " that first uses an A-edge and then a B-edge, the maximum being taken over \
the intermediate vertex ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["k",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8396c183-4f24-414e-b1dd-9d604aee07ac"],
 "."
}], "Text",ExpressionUUID->"64478983-47d9-4d05-92c0-09b916d3e015"],

Cell[TextData[{
 "Concretely on our 2\[Times]2 example: viewing ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7ca4cd08-1c90-4a5b-989e-25c29561b503"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["B",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8fc00402-8942-4265-82f9-aa69f7e252f7"],
 " as labelled edges from \"row\" to \"column\","
}], "Text",ExpressionUUID->"66165088-c2a4-4af6-a475-45d3c6007fec"],

Cell["\<\
(* The four candidate paths feeding entry (1, 1) of A \\[CircleDot] B *)
candidates = Table[
  Module[{w = A[[1, k]] + B[[k, 1]]},
    {\"path 1 -> \" <> ToString[k] <> \" -> 1\",
     \"A[1,\" <> ToString[k] <> \"] + B[\" <> ToString[k] <> \",1]\",
     ToString[A[[1, k]]] <> \" + \" <> ToString[B[[k, 1]]],
     w}],
  {k, 1, 2}];
Grid[
  Join[
    {{\"intermediate path\", \"formula\", \"values\", \"weight\"}},
    candidates,
    {{\"winner\", \"max over k\", \"\",
      Max @@ candidates[[All, 4]]}}],
  Frame -> All, Spacings -> {2, 1.0}, Alignment -> {Left, Center},
  Background -> {None,
    {1 -> RGBColor[0.18, 0.30, 0.55],
     -1 -> RGBColor[0.90, 0.60, 0.45]}},
  ItemStyle -> {None,
    {1 -> Directive[White, Bold],
     -1 -> Directive[Black, Bold]}}]\
\>", "Input",ExpressionUUID->"dc12537c-e87f-4195-856e-c16f7ba2112f"],

Cell[BoxData[
 PaneBox[
  TagBox[GridBox[{
     {"\<\"intermediate path\"\>", "\<\"formula\"\>", "\<\"values\"\>", \
"\<\"weight\"\>"},
     {"\<\"path 1 -> 1 -> 1\"\>", "\<\"A[1,1] + B[1,1]\"\>", "\<\"1 + 0\"\>", 
      "1"},
     {"\<\"path 1 -> 2 -> 1\"\>", "\<\"A[1,2] + B[2,1]\"\>", "\<\"2 + 2\"\>", 
      "4"},
     {"\<\"winner\"\>", "\<\"max over k\"\>", "\<\"\"\>", "4"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Center}}},
    GridBoxBackground->{
     "Columns" -> {{None}}, 
      "RowsIndexed" -> {
       1 -> RGBColor[0.18, 0.3, 0.55], -1 -> RGBColor[0.9, 0.6, 0.45]}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxItemStyle->{"Columns" -> {{None}}, "RowsIndexed" -> {1 -> Directive[
          GrayLevel[1], Bold], -1 -> Directive[
          GrayLevel[0], Bold]}},
    GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{1.}}}],
   "Grid"],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"7eb1ef4f-2b3b-44d4-958a-ac41060aef47"],

Cell[TextData[{
 "Two intermediate vertices, two candidate two-step paths, the heavier one \
wins. Now repeat for every ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"i", ",", "j"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a30d41e4-d049-4f56-ba08-775c63110d78"],
 " pair and you have ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"A", "\[CircleDot]", "B"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ada86912-aa4c-4106-880c-b623cad8785a"],
 ". Iterate by ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "\[CircleDot]", "B"}], ")"}], "\[CircleDot]", "B"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "34c3cdca-1264-4d43-b724-4ab8ee55df4f"],
 " to get heaviest three-step paths, and so on. The next subsection collects \
all of these at once."
}], "Text",ExpressionUUID->"824860a4-f897-4f36-bf96-7faa582eeebf"],

Cell["The Kleene star", "Subsection",ExpressionUUID->"dfdc6ab8-930a-42d6-8a8f-2f1a18bbc5bb"],

Cell[TextData[{
 "For a square tropical matrix ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8a897d35-f650-4139-8ae1-7653a52f558b"],
 " the Kleene star (\"transitive closure\" in min-plus) is"
}], "Text",ExpressionUUID->"5a3cac51-0bf1-442d-846c-b4fd3e9b9169"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{"A", "\"*\""},
      "Superscript"], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["\[ImaginaryI]", "n"], "\[CirclePlus]", "A", "\[CirclePlus]", 
      TemplateBox[{"A", 
        RowBox[{"\[CircleTimes]", "2"}]},
       "Superscript"], "\[CirclePlus]", 
      TemplateBox[{"A", 
        RowBox[{"\[CircleTimes]", "3"}]},
       "Superscript"], "\[CirclePlus]", "\[Ellipsis]"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"31e06363-b96b-4816-a0b7-03c69ea814a7"],

Cell[TextData[{
 "i.e. the matrix whose ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\"\<A^*\>\"", "\"\<i,j\>\""],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c6b2d26b-ebaf-4ba4-853a-aa67360efcb3"],
 " entry is the largest-weight path of any length from ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["i",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "cdec93bc-6160-408d-af16-0926a8f383a4"],
 " to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "da28a8d1-d3ca-45ef-b573-0689a30c38c2"],
 ". On a graph with no positive-weight cycle the series stabilises after at \
most ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"n", "-", "1"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c941f34a-45cf-497f-a0f2-10c75853064a"],
 " products. We compute it explicitly:"
}], "Text",ExpressionUUID->"bb6eb039-e529-469b-8a21-48ec683c16c1"],

Cell["\<\
KleeneStar[A_?MatrixQ] := Module[{n = Length[A], acc, term},
  acc  = MPIdentity[n];
  term = MPIdentity[n];
  Do[
    term = A \\[CircleDot] term;
    acc  = MapThread[Max, {acc, term}, 2],
    {n - 1}];
  acc
];

(* longest-path matrix of a DAG with three nodes and two edges *)
adj = {{-Infinity, 2, -Infinity},
       {-Infinity, -Infinity, 3},
       {-Infinity, -Infinity, -Infinity}};
KleeneStar[adj] // MatrixForm\
\>", "Input",ExpressionUUID->"99fac3eb-bc5f-4764-a438-2bf6754d3685"],

