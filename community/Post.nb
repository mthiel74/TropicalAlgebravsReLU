Cell["\<\
Worked example. The 5-node graph with edge weights and its full shortest-path \
distance matrix.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"57c0c62c-87ef-4953-8471-e82403c8f643"],

Cell["4.  Classical application -- project scheduling", "Section",ExpressionUUID->"fa719524-c53c-4a1a-8c5c-89fcd4ba6266"],

Cell[TextData[{
 "Suppose ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d5db0688-5dab-4381-b564-061fdb358cf7"],
 " tasks have durations ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["d", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "93807af9-52ac-41b9-b0e7-7ecc762d9044"],
 " and precedence constraints ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"i", "\[Rule]", "j"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "61b91404-ea87-46b3-8189-b76c564f9537"],
 " meaning \"task ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["i",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c5cb001b-1698-4b9c-99d7-5775b0b6502e"],
 " must finish before task ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8c976dde-65e8-4358-a705-4d4ddf46029a"],
 " starts\". The earliest completion time of each task is the longest path \
from any source to that task plus its own duration -- again a tropical \
mat-vec / Kleene star, this time with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f78c139f-ea40-41fb-847a-33a9f9160d2a"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CirclePlus",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "08ffd99d-2911-4207-8058-f58e35391684"],
 "."
}], "Text",ExpressionUUID->"44d0a14f-f1f2-47b8-9646-228751f91c2c"],

Cell["\<\
durations = {3, 2, 4, 1, 3, 2, 4, 2};
prereqs   = {1 -> 3, 2 -> 3, 3 -> 5, 4 -> 5, 5 -> 7, 6 -> 7, 7 -> 8};
schedule = MPSchedule[durations, prereqs]\
\>", "Input",ExpressionUUID->"6192ddad-7ae9-49d7-82b9-ab0d7444ba78"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"EarlyStart\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "3", ",", "0", ",", "7", ",", "0", ",", "10", ",", 
       "14"}], "}"}]}], ",", 
    RowBox[{"\<\"EarlyFinish\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "3", ",", "2", ",", "7", ",", "1", ",", "10", ",", "2", ",", "14", ",", 
       "16"}], "}"}]}], ",", 
    RowBox[{"\<\"Makespan\"\>", "\[Rule]", "16"}]}], "\[RightAssociation]"}],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"9aec1da0-9a58-47cd-9eb5-5273a69705e4"],

Cell[TextData[{
 "The earliest each task can finish, given the dependencies, is in ",
 StyleBox["EarlyFinish",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 "; the overall makespan is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"sched", "(", "\"\<Makespan\>\"", ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "051f8957-6575-4a9f-8514-d0c1ecd7d5ff"],
 ". This is the length of the longest path through the DAG -- the ",
 StyleBox["critical path",
  FontSlant->"Italic"],
 "."
}], "Text",ExpressionUUID->"297279a7-6849-4c67-8062-4e6d6fb839ae"],

