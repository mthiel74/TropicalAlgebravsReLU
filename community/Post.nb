Cell[8901161, 146755, 118, 0, 70, "Section",ExpressionUUID->"542f9476-3b0c-4dbe-9291-bce79893fbbb"],
Cell[8901282, 146757, 436, 13, 70, "Text",ExpressionUUID->"d504a7a2-c15b-4adb-aacb-89eead2a608c"],
Cell[8901721, 146772, 490, 15, 70, "DisplayFormula",ExpressionUUID->"9c6128f1-25ee-40e3-9688-fa4395bf53df"],
Cell[8902214, 146789, 1621, 62, 70, "Text",ExpressionUUID->"d973ece5-d2a6-42db-81cb-823814a8a348"],
