   Editable->True]], "InlineFormula",ExpressionUUID->
  "848b78bb-c452-46d4-a750-3a0c2506ae84"],
 " with exponents that form the Minkowski sum of the two single-unit Newton \
segments and the origin, i.e. the four corners of the parallelogram with \
sides (w1 a1, w1 b1) and (w2 a2, w2 b2)."
}], "Text",ExpressionUUID->"3894f00d-fc4c-4153-87b1-3bdb227421fb"],

Cell["Mixed signs", "Subsection",ExpressionUUID->"e85236cb-5fee-498b-8427-2ab403bce010"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["w", "1"], ">", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "1c78e88c-59c5-4579-817f-697970d06439"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["w", "2"], "<", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "724cbc1f-6415-4dd8-bcb0-2f09c2f9bdf1"],
 ":"
}], "Text",ExpressionUUID->"bc02fb77-f697-489b-a5cd-0a01c678cea1"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"P", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"e", ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["w", "1"], " ", 
         SubscriptBox["\[ScriptL]", "1"]}], "+", "e"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"f1308296-5db0-4b62-81df-4e6e451ab990"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"Q", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        TemplateBox[{
          SubscriptBox["w", "2"]},
         "Abs"], " ", 
        SubscriptBox["\[ScriptL]", "2"]}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6f864d74-325a-46ea-84ef-cfacc41eb5ac"],

Cell["\<\
A proper tropical rational. Adding more hidden units of the same sign \
tropical-multiplies into P (or Q), doubling the monomial count in the worst \
case.\
\>", "Text",ExpressionUUID->"9d93d861-7134-4f8e-88bf-996e84655de4"],

Cell["12.  Other tropical-compatible layers", "Section",ExpressionUUID->"44fd9e5d-cb8e-4fc2-9f8f-9985b733d8bc"],

Cell["\<\
The ReLU \[Rule] tropical correspondence is not a one-off curio. Many \
standard deep-learning building blocks are already tropical:\
\>", "Text",ExpressionUUID->"387de697-bf66-4147-87b4-571e60060c8f"],

Cell["Leaky ReLU", "Subsection",ExpressionUUID->"c9dd7f42-8ee6-4d40-bb27-8dce7673602d"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\"\<LeakyReLU\>\"", "(", 
      RowBox[{"x", ",", "\[Alpha]"}], ")"}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", "x"}], ",", "x"}], ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", "x"}], "\[CirclePlus]", "x"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"5530e812-4e4a-4381-bff7-1ecfa6ef3350"],

Cell["\<\
Two monomials of slopes \[Alpha] and 1; for \[Alpha] in (0, 1) the leaky \
variant simply rotates the negative half of the ReLU off the x-axis. Still a \
degree-1 tropical polynomial.\
\>", "Text",ExpressionUUID->"37f845df-fe09-45a1-b682-92077d686d8d"],

Cell["\<\
LeakyReLU[x_, alpha_] := alpha x \\[CirclePlus] x;
LeakyReLU[#, 0.1] & /@ {-2., -0.5, 0., 0.7, 2.}\
\>", "Input",ExpressionUUID->"b5b870af-5018-4173-b396-051890cdc485"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.2`"}], ",", 
   RowBox[{"-", "0.05`"}], ",", "0.`", ",", "0.7`", ",", "2.`"}], 
  "}"}]], "Output",ExpressionUUID->"5e41e4f9-f323-4583-bc94-644d5c9db7b8"],

Cell["MaxPool", "Subsection",ExpressionUUID->"aee5b40f-7b3b-4c54-a186-238240023e1a"],

Cell[TextData[{
 "Max-pooling over a window ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["W",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "63bfb3f2-e3c1-469c-bd11-97d6a03a4966"],
 " of size ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["k",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4286e8ba-00ca-43af-a9c6-735fdee0861a"],
 " is, by definition, a tropical sum:"
}], "Text",ExpressionUUID->"4c38ca88-6450-4f8f-9ae2-4aa1841cb41d"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\"\<MaxPool\>\"", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Max", "\"\<i \[Element] W\>\""], " ", 
      SubscriptBox["x", "i"]}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["x", 
       SubscriptBox["i", "1"]], "\[CirclePlus]", 
      SubscriptBox["x", 
       SubscriptBox["i", "2"]], "\[CirclePlus]", "\[Ellipsis]", "\[CirclePlus]", 
      SubscriptBox["x", 
       SubscriptBox["i", "k"]]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"b1e6b286-2f6e-4163-b16e-53976c902d48"],

Cell["\<\
A CNN built from convolutions + ReLU + MaxPool is therefore already a \
tropical rational map -- with no other operations involved.\
\>", "Text",ExpressionUUID->"b1a61acc-e7e2-477a-8842-b77d1938eb7a"],

Cell["\<\
MaxPool1D[x_List, k_Integer] :=
  Table[Max @@ x[[i ;; i + k - 1]], {i, 1, Length[x] - k + 1}];

MaxPool1D[{1, 3, 2, 7, 4, 5, 2, 8, 1}, 3]\
\>", "Input",ExpressionUUID->"66cd5753-08bd-47f1-b598-ce073cba128a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "7", ",", "7", ",", "7", ",", "5", ",", "8", ",", "8"}], 
  "}"}]], "Output",ExpressionUUID->"638ce2a5-7fa7-4fb3-907c-9fc7fc773e31"],

Cell["Hard tanh", "Subsection",ExpressionUUID->"d9c4b76e-a869-4d1f-89aa-4ae6a42ccecd"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\"\<HardTanh\>\"", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"min", "(", 
      RowBox[{"1", ",", 
       RowBox[{"max", "(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "x"}], ")"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"d623941d-fcf2-4ab8-9239-61363930779a"],

Cell["\<\
A composition of one tropical sum and one classical \"min\". The min-plus \
algebra and the max-plus algebra are duals of one another (negate the \
values); so hard-tanh is a min-max-plus rational.\
\>", "Text",ExpressionUUID->"8bdafae0-927d-4e93-92ac-2a29ccb1e261"],

Cell["Maxout (Goodfellow et al., 2013)", "Subsection",ExpressionUUID->"5f10238c-5396-4b76-adb4-4a51bad4fbec"],

Cell[TextData[{
 "A maxout unit computes ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "370fdae7-7fba-46ce-bcaf-5f4b399c794e"],
 " of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["k",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "230acfa8-344e-4ab3-8723-6868e69e1a63"],
 " affine functions of its input:"
}], "Text",ExpressionUUID->"aec1f83b-f10e-483d-a1f7-34e0cad899a7"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\"\<MaxoutUnit\>\"", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Max", "\"\<i = 1 .. k\>\""], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["w", "i"], ".", "x"}], "+", 
        SubscriptBox["b", "i"]}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"e85f40b8-e303-49b7-baaf-f6aad67a0db7"],

Cell[TextData[{
 "Equivalently, ",
 StyleBox["a maxout unit IS a tropical polynomial",
  FontWeight->"Bold"],
 ". The hidden layer of a maxout network is a vector of tropical polynomials, \
and the whole network is a tropical rational map by construction -- no \
decomposition needed, no positive/negative weight split. From the tropical \
standpoint, maxout is a more natural activation than ReLU."
}], "Text",ExpressionUUID->"d644cfc8-55c7-44f8-bdeb-98a290cb15a1"],

Cell["\<\
MaxoutUnit[x_?VectorQ, W_?MatrixQ, biases_?VectorQ] :=
  Max @@ (W . x + biases);

W = {{1., 0.5}, {-1., 2.}, {0., -1.}};
b = {0.1, -0.2, 0.3};
MaxoutUnit[{1.0, 1.0}, W, b]\
\>", "Input",ExpressionUUID->"6c11068c-3320-4e73-b026-ed7cf8a1d9b8"],

Cell[BoxData["1.6`"], "Output",ExpressionUUID->"7ecf32a1-14a3-49e0-8d3a-1b93b8c8b3b8"],

Cell["Skip connections", "Subsection",ExpressionUUID->"21365f18-5cab-4a7d-a631-d88f012e3a1e"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"\"\<ResBlock\>\"", "(", "x", ")"}], "\[LongEqual]", 
     RowBox[{"x", "+", 
      RowBox[{"\"\<F\>\"", "(", "x", ")"}]}], "\[LongEqual]", 
     RowBox[{"x", "\[CircleTimes]", 
      RowBox[{"\"\<F\>\"", "(", "x", ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"6507fadf-9f1d-49f5-a297-1427ee98f167"],

Cell[TextData[{
 "Classical addition is tropical ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CircleTimes",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "cbdbe97d-b848-46fd-8e0a-feafe90672cf"],
 ", so a residual connection is just a tropical product. A ResNet of ReLU \
layers stays inside the tropical algebra."
}], "Text",ExpressionUUID->"b0476982-fe18-43be-a48c-0fc196cacd7c"],

Cell["13.  Train a tiny classifier and verify", "Section",ExpressionUUID->"ae40d2a0-56d1-46e8-8a20-b6e17c323505"],

Cell["\<\
We pick the two-moons dataset and a 2 \[Rule] 12 \[Rule] 1 ReLU MLP. The \
whole block runs in a fresh kernel:\
\>", "Text",ExpressionUUID->"54efb988-dc7d-49fd-8846-263253e32c26"],

Cell["\<\
SeedRandom[7];
makeMoons[nPerClass_: 200, noise_: 0.15] :=
  Module[{th},
    th = Subdivide[0, Pi, nPerClass - 1];
    Join[
      Thread[{Transpose[{Cos[th], Sin[th]}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], 1}],
      Thread[{Transpose[{1 - Cos[th], -Sin[th] - 0.5}] +
              RandomVariate[NormalDistribution[0, noise], {nPerClass, 2}], \
-1}]]
  ];

data      = makeMoons[];
trainData = (#[[1]] -> {N[#[[2]]]}) & /@ data;

trained = NetTrain[
  NetChain[{LinearLayer[12], ElementwiseLayer[\"ReLU\"], LinearLayer[1]},
           \"Input\" -> 2],
  trainData,
  MaxTrainingRounds -> 800,  BatchSize -> 64,
  LearningRate -> 0.01,      TrainingProgressReporting -> None,
  RandomSeeding -> 1];

A = Normal @ NetExtract[trained, {1, \"Weights\"}];
b = Normal @ NetExtract[trained, {1, \"Biases\"}];
c = Flatten @ Normal @ NetExtract[trained, {3, \"Weights\"}];
d = First @ Flatten @ Normal @ NetExtract[trained, {3, \"Biases\"}];\
\>", "Input",ExpressionUUID->"edbc8f9c-c781-477b-8b7e-81cf177f4886"],

Cell["\<\
Now write the two forward passes explicitly and compare them:\
\>", "Text",ExpressionUUID->"8e74b2aa-5b83-472e-8fad-716f451450d4"],

Cell["\<\
fReLU[x_]    := c . Map[Max[0, #] &, A . x + b] + d;

fMaxPlus[x_] := Module[{P, Q},
  P = Sum[If[c[[j]] > 0,
              Max[0, c[[j]] (A[[j]] . x) + c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[d, 0];
  Q = Sum[If[c[[j]] < 0,
              Max[0, -c[[j]] (A[[j]] . x) - c[[j]] b[[j]]], 0],
           {j, Length[c]}] + Max[-d, 0];
  P - Q
];

SeedRandom[123];
xs = RandomReal[{-2, 2}, {2000, 2}];
Max[Abs[fReLU /@ xs - fMaxPlus /@ xs]]\
\>", "Input",ExpressionUUID->"5db2068d-3e48-4d54-a739-7810ac7f4641"],

Cell[BoxData["2.3314683517128287`*^-15"], "Output",ExpressionUUID->"69623e08-d37a-4e47-9628-4a4360008f5b"],

Cell[TextData[{
 "The two evaluators agree to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["fwErr",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4519742f-6aaf-47f5-8a58-3a0b7a4a9399"],
 " over 2000 random points. They compute the same function -- in two \
different algebras."
}], "Text",ExpressionUUID->"1aaf42b3-e36d-4f84-ad3f-b6d1afb31fec"],

