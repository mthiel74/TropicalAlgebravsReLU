Cell[TextData[{
 "Reading off: from node 1 you can reach node 3 with weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["5",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4d19a0b6-29ae-450c-b164-064f06cbfb2a"],
 " = ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"2", "+", "3"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f0abf7a3-1ef8-4e36-9764-f12f3e287e2b"],
 " via 1\[Rule]2\[Rule]3. The ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c3d426e7-90ea-4efe-96f8-e81d06ec39ae"],
 " entries mean \"unreachable\" -- the additive identity, which absorbs ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CirclePlus",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "eff79298-5638-41bc-a3c9-ae48b1a121b9"],
 "."
}], "Text",ExpressionUUID->"c0405862-ea4b-4da2-9c38-3d59ac32ac0c"],

Cell["3.  Classical application -- shortest paths", "Section",ExpressionUUID->"b4ee3467-d736-457a-b3be-d6efc23fb0f5"],

Cell[TextData[{
 "Switch ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "add97d3b-b5b3-4d12-8b2b-e9dccc5ff3bb"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Min",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bb5191ea-3121-4284-8477-8649db3ad0fa"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"+", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9632a3ce-c0a0-4b69-9261-48fc95d1657c"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"-", "\[Infinity]"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c44ad86a-ac75-4198-8852-e7378a189b81"],
 " and the tropical Kleene star computes shortest-path distances. Concretely: \
the Bellman-Ford recurrence"
}], "Text",ExpressionUUID->"53ca989f-15cf-4eb9-b401-4d0406c2ed3c"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["d", 
       RowBox[{"t", "+", "1"}]], "(", "v", ")"}], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["Min", "u"], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["d", "t"], "(", "u", ")"}], "+", 
       SubscriptBox["\"\<cost\>\"", 
        RowBox[{"u", ",", "v"}]]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"d30e2e89-a8f8-4f19-8271-3b6f82673299"],

Cell["\<\
is, in min-plus algebra, literally a tropical matrix-vector product. \
Iterating to a fixed point gives the Kleene star of the cost matrix, hence \
the entire all-pairs distance matrix.\
\>", "Text",ExpressionUUID->"fcaccd91-2954-4e63-b6d0-79438c35efaf"],

Cell[TextData[{
 "Our convenience wrapper ",
 StyleBox["MPShortestPathDistances",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 " negates the cost matrix, runs the max-plus KleeneStar, and negates back:"
}], "Text",ExpressionUUID->"cec7553b-a761-43ce-878a-c09142bb5238"],

Cell["\<\
MPShortestPathDistances[adj_?MatrixQ] := -KleeneStar[-adj];

(* A small 5-node weighted digraph. *)
edges = {1 -> 2 -> 3, 1 -> 3 -> 5, 2 -> 3 -> 1,
         2 -> 4 -> 4, 3 -> 5 -> 2, 4 -> 5 -> 1, 3 -> 4 -> 1};
n = 5;
costM = ConstantArray[Infinity, {n, n}];
Do[
  costM[[e[[1]], e[[2, 1]]]] = e[[2, 2]],
  {e, edges}];

distM = MPShortestPathDistances[costM];
distM // MatrixForm\
\>", "Input",ExpressionUUID->"93ef0350-56d4-444c-b353-eb86252e21e3"],

