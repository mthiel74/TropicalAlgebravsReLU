Cell["\<\
Worked example. The 5-node graph with edge weights and its full shortest-path \
distance matrix.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"bda89968-c9dc-449d-9c95-93d6452d73ca"],

Cell["4.  Classical application -- project scheduling", "Section",ExpressionUUID->"e4f21200-c3b8-4ede-a1fe-0b32d97d5254"],

Cell[TextData[{
 "Suppose ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "37af6ce7-8d3d-42e3-9854-7d7312b6ac0c"],
 " tasks have durations ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["d", "i"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "86d5e2d3-f539-4e6a-8afc-6fc73acc313f"],
 " and precedence constraints ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"i", "\[Rule]", "j"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e2568f87-7c25-44b6-a45d-59e01b4b35c7"],
 " meaning \"task ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["i",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bf439a56-60fd-4e82-a047-b292b473be0c"],
 " must finish before task ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["j",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "755dd782-3c1c-4e04-a647-6eaf72446edd"],
 " starts\". The earliest completion time of each task is the longest path \
from any source to that task plus its own duration -- again a tropical \
mat-vec / Kleene star, this time with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "602b9578-bbf2-45fb-9c93-1d4526264081"],
 " for ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["CirclePlus",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c5f18bf4-ac11-4419-9a86-d7fc006ce1aa"],
 "."
}], "Text",ExpressionUUID->"4e0f9a1b-6b28-4ce4-acc1-317bf2ffbd84"],

Cell["\<\
durations = {3, 2, 4, 1, 3, 2, 4, 2};
prereqs   = {1 -> 3, 2 -> 3, 3 -> 5, 4 -> 5, 5 -> 7, 6 -> 7, 7 -> 8};
schedule = MPSchedule[durations, prereqs]\
\>", "Input",ExpressionUUID->"957de9c8-dca4-493c-82f5-bb8fc38bcbe1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"EarlyStart\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "0", ",", "3", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
      "0"}], "}"}]}], ",", 
   RowBox[{"\<\"EarlyFinish\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "3", ",", "2", ",", "7", ",", "1", ",", "3", ",", "2", ",", "4", ",", 
      "2"}], "}"}]}], ",", 
   RowBox[{"\<\"Makespan\"\>", "\[Rule]", "7"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"4eeba0fd-5c2c-41a3-bc00-\
cc293002498c"],

Cell[TextData[{
 "The earliest each task can finish, given the dependencies, is in ",
 StyleBox["EarlyFinish",
  FontFamily->"Source Code Pro",
  Background->GrayLevel[0.95]],
 "; the overall makespan is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"sched", "(", "\"\<Makespan\>\"", ")"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3fa24b46-13d3-443d-92d8-f9bdc6393717"],
 ". This is the length of the longest path through the DAG -- the ",
 StyleBox["critical path",
  FontSlant->"Italic"],
 "."
}], "Text",ExpressionUUID->"2e374c2f-5baf-4410-a7c5-727368b9c38a"],

