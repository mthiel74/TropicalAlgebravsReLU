Cell["\<\
Five random draws, two columns of equal numbers. The identity holds pointwise \
-- it is an algebraic equation, not an approximation.\
\>", "Text",ExpressionUUID->"fb0e7f49-27f0-48fa-890e-1676a95eca44"],

Cell["10.  Symbolic derivation: 2 \[Rule] 1 \[Rule] 1 network", "Section",ExpressionUUID->"702ebd20-2e22-4865-b877-da86ddec1a9c"],

Cell[TextData[{
 "The smallest non-trivial classifier has one hidden ReLU unit. With weights ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["a",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a6c9bcfd-73b6-4b2b-9d86-f3f407493417"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["b",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8adcf2cd-8fce-4a28-842f-4e95ac301ce8"],
 ", bias ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["c",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a4434af8-018d-43e5-a561-3d68ec411fef"],
 ", output weight ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["w",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "50b034c5-e4d2-43a1-b19a-f3969435fc6f"],
 " and output bias ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["e",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "975aa289-c3aa-448a-b94d-be9443243dc1"],
 ":"
}], "Text",ExpressionUUID->"347fc517-b6f5-47a6-88b0-5a80dd622bb0"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"h", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"a", " ", 
         SubscriptBox["x", "1"]}], "+", 
        RowBox[{"b", " ", 
         SubscriptBox["x", "2"]}], "+", "c"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"0ffcad97-fea6-45d0-a3d8-b345e5d77a94"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"f", "\[LongEqual]", 
     RowBox[{
      RowBox[{"w", " ", "h"}], "+", "e"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"035a1aa9-f3fb-48be-9722-ef70b76f867b"],

Cell["Case 1.  w > 0", "Subsection",ExpressionUUID->"299f23d5-c411-458f-b4c4-2618d3091284"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["w",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "6d3f14d3-42ff-4421-aa7c-69792d3b4ea4"],
 " is positive we can pull it inside the ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Max",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ddb5d409-4c03-477d-b645-2d95293a183b"],
 " (",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"w", " ", 
       RowBox[{"max", "(", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], ")"}]}], "\[LongEqual]", 
      RowBox[{"max", "(", 
       RowBox[{
        RowBox[{"w", " ", "\[Alpha]"}], ",", 
        RowBox[{"w", " ", "\[Beta]"}]}], ")"}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ca7473a0-d37a-4426-83c8-a21a2fad58ff"],
 "). That gives"
}], "Text",ExpressionUUID->"e8b33517-4a5d-4cd4-b513-ac2252874a09"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"f", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"e", ",", 
       RowBox[{
        RowBox[{"w", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", " ", 
            SubscriptBox["x", "1"]}], "+", 
           RowBox[{"b", " ", 
            SubscriptBox["x", "2"]}], "+", "c"}], ")"}]}], "+", "e"}]}], 
      ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"693176eb-30b6-450d-9ca2-e70d3090f43d"],

Cell[TextData[{
 "which is ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"P", "(", "x", ")"}], "-", 
      RowBox[{"Q", "(", "x", ")"}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "b518d292-a3c9-4ab3-aa01-eeccafe46192"],
 " with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"Q", "\[LongEqual]", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c1ec8bf7-393a-46b6-a7df-448825ae184e"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f1b46bd7-a865-4bd1-9879-9b8bf59922c5"],
 " a tropical polynomial of degree 1 (two monomials)."
}], "Text",ExpressionUUID->"9f109f4d-ebb3-4e37-82b3-5eb7b4d03cc2"],

Cell["Case 2.  w < 0", "Subsection",ExpressionUUID->"214771bf-66e9-4873-bbf0-e8e840d0a7b0"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"w", "\[LongEqual]", 
      RowBox[{"-", 
       TemplateBox[{"w"},
        "Abs"]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "0ac6ac6a-a664-4a73-af6c-bf7b615bc8c7"],
 ". Then ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        TemplateBox[{"w"},
         "Abs"]}], " ", 
       RowBox[{"max", "(", 
        RowBox[{"0", ",", "\[ScriptL]"}], ")"}]}], "\[LongEqual]", 
      RowBox[{"-", 
       RowBox[{"max", "(", 
        RowBox[{"0", ",", 
         RowBox[{
          TemplateBox[{"w"},
           "Abs"], " ", "\[ScriptL]"}]}], ")"}]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "33e56932-fad8-4cd5-9163-771ebcbf8fc6"],
 ", so"
}], "Text",ExpressionUUID->"5d976389-eb4a-4e72-9c72-da1298995f42"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"f", "\[LongEqual]", 
     RowBox[{"e", "-", 
      RowBox[{"max", "(", 
       RowBox[{"0", ",", 
        RowBox[{
         TemplateBox[{"w"},
          "Abs"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", " ", 
            SubscriptBox["x", "1"]}], "+", 
           RowBox[{"b", " ", 
            SubscriptBox["x", "2"]}], "+", "c"}], ")"}]}]}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"ae72ac42-b7c6-482a-af50-0a3e6c06aac5"],

Cell[TextData[{
 "which is ",
 Cell[BoxData[
  TagBox[
