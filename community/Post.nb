Cell["\<\
Figure 1. Across three trained networks (XOR, moons, spirals), the ReLU \
forward pass and the max-plus forward pass agree at ~10^-14 over 1400+ inputs \
each. Same function, two different algebras.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"daf0930c-c958-48e0-a724-827bea517aa5"],

Cell["14.  Decision boundary as a tropical hypersurface", "Section",ExpressionUUID->"7bf2a169-fc6a-42b3-9fc9-c51e8a099628"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "196d96e9-14ef-4b52-a021-bc969538af68"],
 " hidden units cut input space along ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "722eff2f-d2b4-45f9-bdf7-1afe3c16fcca"],
 " straight crease lines ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["a", "j"], ".", "x"}], "+", 
       SubscriptBox["b", "j"]}], "\[LongEqual]", "0"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "5e27bf4c-77d4-487e-8cf5-b926b8077e87"],
 ". On each open region of the resulting arrangement, the activation pattern ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"\[Sigma]", "\[Element]", 
      SuperscriptBox[
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], "n"]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "0c0af02c-f7a9-47ef-a6de-0607bdd307fe"],
 " is constant and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["f",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "fb2e3b57-de95-4d05-a0ca-673e47fbb3c6"],
 " is affine. The decision boundary ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{"f", "\[LongEqual]", "0"}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "313a0625-dbf1-490e-a868-785764e33b5d"],
 " is the locus where the two convex piecewise-linear surfaces ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["P",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9b22cdca-7d27-4fd8-9b0f-145d4c1817a4"],
 " and ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["Q",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "08a875b2-7597-48ff-b6e4-afe1e9814c8d"],
 " meet -- a tropical hypersurface."
}], "Text",ExpressionUUID->"0b63c152-3862-4104-a670-b2d75abf1df0"],

