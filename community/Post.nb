   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c2c10267-9891-4b12-834f-d96b52e33935"],
 ".  The two expressions are identical on every numerical sample.)"
}], "Text",ExpressionUUID->"e95c9850-6e7e-4a7d-a7c9-69f0cdd218c1"],

Cell["11.  Symbolic derivation: 2 \[Rule] 2 \[Rule] 1 network", "Section",ExpressionUUID->"21fd21b5-2a17-4440-a9c3-87e2d5826920"],

Cell["\<\
With two hidden units we can already produce a non-trivial tropical rational \
(mixed signs) or a tropical polynomial with four monomials (both signs \
positive). Let\
\>", "Text",ExpressionUUID->"5735f161-975a-40b5-9735-b6eacc6de984"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["h", "j"], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["a", "j"], " ", 
         SubscriptBox["x", "1"]}], "+", 
        RowBox[{
         SubscriptBox["b", "j"], " ", 
         SubscriptBox["x", "2"]}], "+", 
        SubscriptBox["c", "j"]}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"ff54ed0d-f210-4539-bb57-a7e5a0365e25"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"f", "\[LongEqual]", 
     RowBox[{
      RowBox[{
       SubscriptBox["w", "1"], " ", 
       SubscriptBox["h", "1"]}], "+", 
      RowBox[{
       SubscriptBox["w", "2"], " ", 
       SubscriptBox["h", "2"]}], "+", "e"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"00f1c2a0-af7c-4ec4-8cd0-acc7454c4b31"],

Cell["Both output weights positive", "Subsection",ExpressionUUID->"9b9cbb34-3bef-4326-a58a-ca1ad1ccd4eb"],

Cell["Apply the identity of \[Section]9 to the two ReLU units:", "Text",ExpressionUUID->"eeb08207-212a-4b61-90db-249d9766b103"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{"P", "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"e", ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["w", "1"], " ", 
         SubscriptBox["\[ScriptL]", "1"]}], "+", "e"}], ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["w", "2"], " ", 
         SubscriptBox["\[ScriptL]", "2"]}], "+", "e"}], ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["w", "1"], " ", 
         SubscriptBox["\[ScriptL]", "1"]}], "+", 
        RowBox[{
         SubscriptBox["w", "2"], " ", 
         SubscriptBox["\[ScriptL]", "2"]}], "+", "e"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"1e838e6a-5968-49ec-b9fd-7ee456d0de5f"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["\[ScriptL]", "j"], "\[LongEqual]", 
      RowBox[{
       RowBox[{
        SubscriptBox["a", "j"], " ", 
        SubscriptBox["x", "1"]}], "+", 
       RowBox[{
        SubscriptBox["b", "j"], " ", 
        SubscriptBox["x", "2"]}], "+", 
       SubscriptBox["c", "j"]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "b8cbd11b-6a5e-4230-9593-d8529b62d40d"],
 ". The four monomials live in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"]}], "}"}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "95727165-705a-437d-8727-caa5b23629e8"],
 " with ",
 StyleBox["exponent vectors",
  FontWeight->"Bold"],
 " (slopes in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SuperscriptBox["R", "2"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "9eaad627-886b-47a7-ba0e-4d556da2f5d0"],
 ") that form the Minkowski sum of the two single-unit Newton segments and \
the origin -- i.e. the four corners of the parallelogram with sides ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["w", "1"], " ", 
