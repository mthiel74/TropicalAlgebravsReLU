Cell["\<\
Illustration. ReLU as a single piecewise-linear ridge: a flat shadow plateau \
meeting a sharp inclined facet at one kink. The whole forward pass of a \
network is built by stacking and summing copies of this shape.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"ad39aefb-bb1d-4dde-b7ef-2039562c826c"],

Cell["9.  The decisive identity", "Section",ExpressionUUID->"ad2748ca-590e-42a7-85c9-cb86808b28af"],

Cell[TextData[{
 "A 1-hidden-layer ReLU network is a ",
 StyleBox["classical sum",
  FontWeight->"Bold"],
 " of ReLU units. The identity that turns a classical sum into a single \
tropical polynomial is"
}], "Text",ExpressionUUID->"50c14e6d-4088-430e-a3f7-38740df22e83"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"max", "(", 
       RowBox[{"0", ",", "A"}], ")"}], "+", 
      RowBox[{"max", "(", 
       RowBox[{"0", ",", "B"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", "A", ",", "B", ",", 
       RowBox[{"A", "+", "B"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"c4efc9db-24d8-4470-bbff-0da972e9dcd6"],

Cell["which, read tropically, says", "Text",ExpressionUUID->"a3bc0702-a2d1-4965-8cd1-98041a6abcc1"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"0", "\[CirclePlus]", "A"}], ")"}], "\[CircleTimes]", 
      RowBox[{"(", 
       RowBox[{"0", "\[CirclePlus]", "B"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", "A", "\[CirclePlus]", "B", "\[CirclePlus]", 
      RowBox[{"A", "\[CircleTimes]", "B"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"cbbe0172-febc-421e-b4f2-9fd2ec40eb42"],

Cell[TextData[{
 "The classical sum of two ReLU units is the ",
 StyleBox["tropical product",
  FontWeight->"Bold"],
 " of their tropical polynomials -- each unit contributing two monomials, the \
product giving four. This identity is the engine behind everything that \
follows."
}], "Text",ExpressionUUID->"be41ecf7-7471-4947-aa03-d49e963be914"],

Cell["\<\
SeedRandom[1];
Table[
  Module[{aval = RandomReal[{-1, 1}], bval = RandomReal[{-1, 1}]},
    {NumberForm[Max[0, aval] + Max[0, bval],   {5, 4}],
     NumberForm[Max[0, aval, bval, aval + bval], {5, 4}]}],
  {5}] // TableForm\
\>", "Input",ExpressionUUID->"2cb1f57e-2843-41d4-b292-fc22f7cf7809"],

