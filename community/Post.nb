Cell["\<\
Illustration. ReLU as a single piecewise-linear ridge: a flat shadow plateau \
meeting a sharp inclined facet at one kink. The whole forward pass of a \
network is built by stacking and summing copies of this shape.\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"84204532-9f67-4c5b-9282-2326f710c1c0"],

Cell["9.  The decisive identity", "Section",ExpressionUUID->"49b2d9d0-cc4b-4f4e-a9ac-c03d289a9ab8"],

Cell[TextData[{
 "A 1-hidden-layer ReLU network is a ",
 StyleBox["classical sum",
  FontWeight->"Bold"],
 " of ReLU units. The identity that turns a classical sum into a single \
tropical polynomial is"
}], "Text",ExpressionUUID->"222fc5fd-5553-4411-9ba9-f44a65ef55f9"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"max", "(", 
       RowBox[{"0", ",", "A"}], ")"}], "+", 
      RowBox[{"max", "(", 
       RowBox[{"0", ",", "B"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"max", "(", 
      RowBox[{"0", ",", "A", ",", "B", ",", 
       RowBox[{"A", "+", "B"}]}], ")"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"1d16ffcd-f6c3-4b94-8355-1f0daca99238"],

Cell["which, read tropically, says", "Text",ExpressionUUID->"340a9a97-042f-4a4d-b565-2e56bbda5345"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"0", "\[CirclePlus]", "A"}], ")"}], "\[CircleTimes]", 
      RowBox[{"(", 
       RowBox[{"0", "\[CirclePlus]", "B"}], ")"}]}], "\[LongEqual]", 
     RowBox[{"0", "\[CirclePlus]", "A", "\[CirclePlus]", "B", "\[CirclePlus]", 
      RowBox[{"A", "\[CircleTimes]", "B"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"453dff41-1d6d-4ffa-86a9-505a74f5a674"],

Cell[TextData[{
 "The classical sum of two ReLU units is the ",
 StyleBox["tropical product",
  FontWeight->"Bold"],
 " of their tropical polynomials -- each unit contributing two monomials, the \
product giving four. This identity is the engine behind everything that \
follows."
}], "Text",ExpressionUUID->"0fdf6b07-f730-4e86-8d93-96604699e6bb"],

Cell["\<\
SeedRandom[1];
Table[
  Module[{aval = RandomReal[{-1, 1}], bval = RandomReal[{-1, 1}]},
    {NumberForm[Max[0, aval] + Max[0, bval],   {5, 4}],
     NumberForm[Max[0, aval, bval, aval + bval], {5, 4}]}],
  {5}] // TableForm\
\>", "Input",ExpressionUUID->"3eb5c1d5-b811-4c75-ae74-4efa84980e87"],

