Cell["\<\
Bivariate tropical polynomial p(x, y) = max(0, x, y, x + y - 1) has four \
linear pieces (left) and Newton polytope the unit square (right).\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"4cf2d310-42fb-4509-bae1-c554d5ac29cc"],

Cell["7.  Tropical eigenvalues -- Karp's algorithm (aside)", "Section",ExpressionUUID->"05d59347-2d66-4d18-a38b-208f926fc4ec"],

Cell[TextData[{
 StyleBox["You can skip this section on a first read",
  FontWeight->"Bold"],
 " -- it is a beautiful classical result inside the tropical algebra, but it \
is not used in the neural-network sections that follow. Included because the \
eigenvalue / cycle-mean duality is the prettiest illustration of the \
algebra's reach. Resume at \[Section]8 if you want to head straight for the \
ReLU connection."
}], "Text",ExpressionUUID->"a21122e1-6488-4c11-abb5-4c8b278d9817"],

Cell[TextData[{
 "For a square tropical matrix ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "02763371-522b-4b7c-adb5-72b063b3100d"],
 " the role of the eigenvalue is played by the maximum mean cycle weight of \
the associated weighted digraph,"
}], "Text",ExpressionUUID->"24b957fc-5d3c-4078-b796-9737c75db699"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Lambda]", "max"], "(", "A", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       UnderscriptBox["Max", "\"\<directed cycles C\>\""], 
       " ", "\"\<(sum of edge weights in C)\>\""}], "\"\<(length of C)\>\""]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"9c297023-b89d-436e-9716-f84c265dd1b0"],

Cell[TextData[{
 "i.e. the largest value of (sum of edge weights in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "26cb3f8a-50a8-41af-8a38-7b7b905e677f"],
 ") / (length of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "25fd1036-852b-4e40-b922-3bece05e88dc"],
 ") over all directed cycles ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "86a89cf6-5218-4fc1-807d-499b52b879b3"],
 ". This is the unique tropical eigenvalue when ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bc67660e-07d4-47a0-92fc-0724b1140252"],
 " is irreducible. Karp's algorithm computes it in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["\"\<O(n^3)\>\"",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "4537b7c4-6768-42f6-ac91-7629ea51752b"],
 " by tracking maximum-weight paths of every length up to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "f611ad0c-b0fc-4c0f-a90c-9702a5d48f23"],
 "."
}], "Text",ExpressionUUID->"7857b51f-cc33-4ad4-b9fe-2c81adebec38"],

Cell["\<\
karpA = {{-Infinity, 2,        -Infinity, -Infinity},
         {-Infinity, -Infinity,  3,         1},
         {0,         -Infinity, -Infinity,  1},
         {4,         -Infinity, -Infinity, -Infinity}};
{
  \"MPCycleMean[karpA]\"  -> MPCycleMean[karpA],
  \"MPEigenvalue[karpA]\" -> MPEigenvalue[karpA],
  \"cycle 1->2->3->4->1\" -> \"weights 2+3+1+4 = 10, mean 2.5\"
} // TableForm\
\>", "Input",ExpressionUUID->"305403bd-27c5-41b5-915e-ac9f4d939efc"],

Cell[BoxData[
 PaneBox[
  TagBox[
   TagBox[GridBox[{
      {
       RowBox[{"\<\"MPCycleMean[karpA]\"\>", "\[Rule]", "2.5`"}]},
      {
       RowBox[{"\<\"MPEigenvalue[karpA]\"\>", "\[Rule]", "2.5`"}]},
      {
       RowBox[{"\<\"cycle 1->2->3->4->1\"\>", 
        "\[Rule]", "\<\"weights 2+3+1+4 = 10, mean 2.5\"\>"}]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column],
   Function[BoxForm`e$, 
    TableForm[BoxForm`e$]]],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"16b09f0b-e998-4467-82e0-0e59b88244d7"],

Cell[TextData[{
 "Iterating ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["x", 
       RowBox[{"t", "+", "1"}]], "\[LongEqual]", 
      RowBox[{"A", "\[CircleDot]", 
       SubscriptBox["x", "t"]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "3b6ca256-f9ba-4487-bfdc-62e0d5bb0358"],
 " from any starting vector makes the mean of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["x",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "37fd52e8-4fd8-43c4-87cd-f9d8672bc96f"],
 " grow asymptotically at rate ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\[Lambda]", "max"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "dbbebf8c-d07f-4bb9-84a0-5538d53791a3"],
 " per step:"
}], "Text",ExpressionUUID->"f571ebfb-102e-4cfb-86fa-3f6e59426a70"],

Cell["\<\
x0 = ConstantArray[0., 4];
traj = MPLinearSystemEvolve[karpA, x0, 12];
Differences[Mean /@ traj]\
\>", "Input",ExpressionUUID->"8f0947ba-10a0-47fc-8a82-fbe2abab7f9f"],

Cell[BoxData[
 PaneBox[
  RowBox[{"{", 
   RowBox[{
   "2.5`", ",", "2.75`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",",
     "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", 
    "2.5`"}], "}"}],
  Alignment->{Center, Top},
  ImageSize->Full]], "Output",
 CellFrame->False,
 TextAlignment->Center,ExpressionUUID->"0fa90e34-33c8-4f0e-b96b-2d112cee3431"],

Cell[TextData[{
 "The increments settle to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["2.5`",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "c37afc2b-31d4-4231-bfdf-87158964b4d6"],
 " after a brief transient -- exactly ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\[Lambda]", "max"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8cd57b8c-6059-4aaf-b9a8-6f958d141498"],
 "."
}], "Text",ExpressionUUID->"4d3ac51b-b987-4cba-8598-461de2a57d40"],

