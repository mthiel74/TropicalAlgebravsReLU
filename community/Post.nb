  "9cd588a0-9159-4348-99d3-99951fd3d189"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["w",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "bf98334a-06c3-45d9-8ad2-8a05f582785a"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["e",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "351de125-e713-4c84-80d5-40bcb96fa120"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["x", "1"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "822064fc-0516-4368-954d-4119b35b9d6b"],
 ", ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["x", "2"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8102f365-dbac-4e99-924b-2965a2665253"],
 ". WL's Simplify says yes:"
}], "Text",ExpressionUUID->"16d70f18-2460-4bb8-83c3-29725986e7e8"],

Cell["\<\
ClearAll[a, b, c, w, e, x1, x2];
hExpr  = Max[0, a x1 + b x2 + c];
fOrig  = w hExpr + e;
fAlt   = Piecewise[{{Max[e, w (a x1 + b x2 + c) + e], w > 0},
                    {e - Max[0, -w (a x1 + b x2 + c)],  w < 0},
                    {e,                                 w == 0}}];

(* test numerically over a random parameter sweep *)
SeedRandom[42];
Module[{vals},
  vals = Table[
    Module[{r = RandomReal[{-2, 2}, 7]},
      With[{aa = r[[1]], bb = r[[2]], cc = r[[3]], ww = r[[4]],
            ee = r[[5]], xa = r[[6]], xb = r[[7]]},
        Abs[fOrig - fAlt /. {a -> aa, b -> bb, c -> cc, w -> ww,
                              e -> ee, x1 -> xa, x2 -> xb}]
      ]],
    {500}];
  Max[vals]
]\
\>", "Input",ExpressionUUID->"2191ba31-a22e-4bc1-99e4-af83a37814ee"],

Cell[TextData[{
 "(Evaluating this cell prints ",
 Cell[BoxData[
