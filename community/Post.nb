Cell["\<\
Bivariate tropical polynomial p(x, y) = max(0, x, y, x + y - 1) has four \
linear pieces (left) and Newton polytope the unit square (right).\
\>", "Text",
 TextAlignment->Center,
 FontFamily->"Helvetica",
 FontSize->11,
 FontSlant->Italic,ExpressionUUID->"06e868a6-c1c1-48c9-b197-66b97d6da027"],

Cell["7.  Tropical eigenvalues -- Karp's algorithm", "Section",ExpressionUUID->"542f9476-3b0c-4dbe-9291-bce79893fbbb"],

Cell[TextData[{
 "For a square tropical matrix ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d758a4a1-ba35-4bee-8f60-e0117e9b7da0"],
 " the role of the eigenvalue is played by the maximum mean cycle weight of \
the associated weighted digraph,"
}], "Text",ExpressionUUID->"d504a7a2-c15b-4adb-aacb-89eead2a608c"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Lambda]", "max"], "(", "A", ")"}], "\[LongEqual]", 
     FractionBox[
      RowBox[{
       UnderscriptBox["Max", "\"\<directed cycles C\>\""], 
       " ", "\"\<(sum of edge weights in C)\>\""}], "\"\<(length of C)\>\""]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"9c6128f1-25ee-40e3-9688-fa4395bf53df"],

Cell[TextData[{
 "i.e. the largest value of (sum of edge weights in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "2636bd72-43cf-484a-9066-c86e0ceb63aa"],
 ") / (length of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "16440fb1-3589-4605-a207-5ea96551e902"],
 ") over all directed cycles ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["C",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "d774ecfc-ef0a-499c-aa9f-e0e891a11ec3"],
 ". This is the unique tropical eigenvalue when ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["A",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "7f147876-38b5-4b2b-9d67-3d5f78f98514"],
 " is irreducible. Karp's algorithm computes it in ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["\"\<O(n^3)\>\"",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "77b0631f-7563-4e8d-8ae9-656bf81a086c"],
 " by tracking maximum-weight paths of every length up to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["n",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "07e6ba8f-659b-44c9-902d-202c7ccf2f77"],
 "."
}], "Text",ExpressionUUID->"d973ece5-d2a6-42db-81cb-823814a8a348"],

Cell["\<\
karpA = {{-Infinity, 2,        -Infinity, -Infinity},
         {-Infinity, -Infinity,  3,         1},
         {0,         -Infinity, -Infinity,  1},
         {4,         -Infinity, -Infinity, -Infinity}};
{
  \"MPCycleMean[karpA]\"           -> MPCycleMean[karpA],
  \"MPEigenvalue[karpA]\"          -> MPEigenvalue[karpA],
  \"main cycle: 1->2->3->4->1, weights\" ->
                                 \"2+3+1+4=10, mean 2.5\"
} // TableForm\
\>", "Input",ExpressionUUID->"e3468541-9835-4d5f-8752-30c27fd68f01"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{"\<\"MPCycleMean[karpA]\"\>", "\[Rule]", "2.5`"}]},
     {
      RowBox[{"\<\"MPEigenvalue[karpA]\"\>", "\[Rule]", "2.5`"}]},
     {
      RowBox[{"\<\"main cycle 1->2->3->4->1, weights 2+3+1+4 = 10, mean \"\>",
        "\[Rule]", "\<\"2.5\"\>"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   Column],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellFrame->False,ExpressionUUID->"3a2c59a9-cc0c-4b7d-ab91-32aefb4c38bd"],

Cell[TextData[{
 "Iterating ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     RowBox[{
      SubscriptBox["x", 
       RowBox[{"t", "+", "1"}]], "\[LongEqual]", 
      RowBox[{"A", "\[CircleDot]", 
       SubscriptBox["x", "t"]}]}],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "e0919144-d35e-4e15-af26-ee5501606987"],
 " from any starting vector makes the mean of ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["x",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "af82d2fb-68db-4aa7-afbc-09d0d08a42f2"],
 " grow asymptotically at rate ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\[Lambda]", "max"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "8ceff9d8-0cd4-4dcc-9af5-949bc4e9e022"],
 " per step:"
}], "Text",ExpressionUUID->"eced0b6f-dea5-435f-88e2-e0169e4ec6b2"],

Cell["\<\
x0 = ConstantArray[0., 4];
traj = MPLinearSystemEvolve[karpA, x0, 12];
Differences[Mean /@ traj]\
\>", "Input",ExpressionUUID->"c4d0dd36-f155-4b53-a648-f1e393f8de16"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.5`", ",", "2.75`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",",
    "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`", ",", "2.5`"}],
   "}"}]], "Output",ExpressionUUID->"8df4767b-3230-440a-bc5b-400fb7f0599c"],

Cell[TextData[{
 "The increments settle to ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox["2.5`",
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "ad8cfcb9-51c5-4d81-a650-bf0729a13bf5"],
 " after a brief transient -- exactly ",
 Cell[BoxData[
  TagBox[
   FormBox[
    TagBox[
     SubscriptBox["\[Lambda]", "max"],
     HoldForm],
    TraditionalForm],
   TraditionalForm,
   Editable->True]], "InlineFormula",ExpressionUUID->
  "a9cbb729-4f0b-4848-8cd6-c3b0a4a53fc1"],
 "."
}], "Text",ExpressionUUID->"6728c534-609c-4ea5-a801-236d197733f4"],

